[
 {
  "id": "UgzDwZvSrcaDiXaXwdt4AaABAg",
  "author": "UCb6fRGhM3o38isb0b9TTpqQ",
  "text": "2년전에는 주차장에서 캠핑했었는데, 동계때도 화장실열려있고ㅎㅎ  저 갔던날 할머님이 재밌게놀고 자주오라고 얘기해주시고 마을주민분들이 화장실정리하신다고하더라고요\n그런데 해변가에 쓰레기 밀려온게 마음아팠음ㅠㅠ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwqNwNCETm5ju16jVp4AaABAg",
  "author": "UCD3wGdFz2GVKIWqgNSV55PA",
  "text": "여기 정말 좋네요^^ 좋은 곳 진짜 잘 찾아내시는 호이쭈리님^^",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyEsDzsN5Mn5JYn6Wt4AaABAg",
  "author": "UCJowehltUnhn5VR1r3qZiaw",
  "text": "서해라니~~~~\n넘~~~~흐~~~좋습니다~~\n깨끗하게 보존됐으면 좋겠네요~~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugylz8P-oxqOdaQm0yN4AaABAg",
  "author": "UCygHApIlQUJTf2_7ucXirYw",
  "text": "바다뷰 정말 좋네요~ㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwNu12pzGU4WZWydkJ4AaABAg",
  "author": "UCRK84k-M87X9UnA-9K1jSng",
  "text": "그저께다녀왔습니다\n넘좋았어요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzWEsRL6e1Uxo-OMcp4AaABAg",
  "author": "UC_7aMnyvweXsfHDVFqxT3TQ",
  "text": "썸네일보고 바로 알았네요 ㅎㅎ 바다뷰 좋지요~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwFwQaWg6VwWNa3wsZ4AaABAg",
  "author": "UCxET_o5pG7s7v7C1y_inkRQ",
  "text": "저ㅋㅋ예능프로가 설마\n힌트면 어쩌나ㅋㅋㅋ\n그걸봐야 하나, 흐억 했는데\n두번보니 똭ㅡ있네요ㅎㅎ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw1b1ZWqZXmGlrF_gh4AaABAg",
  "author": "UCs20D34GMFH8fbepmY6FCGg",
  "text": "어딘가 알것같습니다 좋은곳이지요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzJrOBab9km3rrXp1h4AaABAg",
  "author": "UCNzX0oZSKNX6KKgPCCs5esg",
  "text": "바다다~~~~\n물놀이 좋아하는 애들만 아니면 바다 참 좋은데..\n아쉽네요.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxCs4mV0GXbmIf6d_B4AaABAg",
  "author": "UCN5BKPRkpBS0jOSI_5ecK-g",
  "text": "아직도 갈 수 있나요?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwDPIdpttNbh0O-T9Z4AaABAg",
  "author": "UCyFO_FoNRywMq0tBV7jhSKA",
  "text": "주변 캠핑카 주차 금지라는 게 주차장에도 대지 말라는 건가요?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyPd0PfaTFFg3vsxSR4AaABAg",
  "author": "UC3xUcHEAEQl2GA3h3PEtbKw",
  "text": "짜증나네 ㅋㅋ",
  "likes": 1,
  "is_creator": false
 }
