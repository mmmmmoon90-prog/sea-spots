[
 {
  "id": "UgyaDDNGWEsKo6txq2p4AaABAg",
  "author": "UCVxR1J5CP5WJz9ILt1tWDZg",
  "text": "죽도네요 라고 바로 나와야 낚시에 진짜 빠진거임ㅋㅋㅋ",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgzTlSIAqKeXfh1obxR4AaABAg",
  "author": "UCUANLlxhUGUdd0RpPaXMbxw",
  "text": "뭐든지 빠지면 스스로 헤어나오질 못함",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugy8E29LcC65GZtp-a14AaABAg",
  "author": "UCAF2Nsck38Il-zesR_zxFjw",
  "text": "매일 낚시생각 특히 집앞에 포인트라도 있으면 퇴근하고 낚시감 \n채비 손실없고 집앞이라는 장점살려서 다른돈 안들고 밑밥 미끼만 40만 \n하지만 막상 들어가는돈 보면 100이상",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy5B4E3-64i8ZBUkuR4AaABAg",
  "author": "UC9EI1ULD7W0QH0gtKhBO1bQ",
  "text": "쵝오의 여자!",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugxwqt0TWsTj9E8HLsh4AaABAg",
  "author": "UC8swkepRAdDA9SBZtlZTIcg",
  "text": "네ㆍ맞습니다. 제가 작년 부터 이병에 걸렸습니다😊😊😊😊",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugzz_mpbTGpMtV2rEcR4AaABAg",
  "author": "UC7qEC-5xFBYBlD7GVrf6Wfg",
  "text": "스포츠를 아시는 분이시네 낚시는 과학이고 스포츠고 사냥고 손맛이고 힐링이다  스트레스풀고 경치도 구경하고 남해를가든 동해를가든 갈만한 일이 생겨서 즐겁다\n위험한곳 피하시고 행복하시길 응원합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyorfVmH4jaP4vGMNp4AaABAg",
  "author": "UCARL3yV4u8-dNfj3DmtjncA",
  "text": "부럽다 ...남편분은",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxnWCkcTxTkmAIi2wN4AaABAg",
  "author": "UCZP8nH99yNnPvrHNZN-aQww",
  "text": "저기서 잡히는 고기 생으로 먹지마요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxeEhyaj1QmojPFCbd4AaABAg",
  "author": "UC_CSCiRGIyRsTBaDsmZNaKA",
  "text": "낚시는 위험해요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyDTbLjTFNnDEcquzN4AaABAg",
  "author": "UCBmZguGcTgZcJnFhd1I2OMg",
  "text": "낚시병은 심각하죠ㅋㅋ 남녀노소 구분없어요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugz8RVBcVKzdzBplM214AaABAg",
  "author": "UCaG46bGUiKI6z4VIiAvhdVg",
  "text": "남자도 똑같은듯....",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwdbPQbLOioFeMo2WB4AaABAg",
  "author": "UCn7-fuGJYOqJtsgfrFKd1Lg",
  "text": "쵝오의 여친?! ㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugwf50QIlOsivbBMcmZ4AaABAg",
  "author": "UCMziYSFNgJmTgjODBb9yuGQ",
  "text": "중독의 위험성.",
  "likes": 0,
  "is_creator": false
 }
]