[
 {
  "id": "Ugxx_Rb364ZLqIgU6dh4AaABAg",
  "author": "UCI4WkSMJktyIDSENzO7vGVA",
  "text": "잡는것도 잡는거지만 잡아서 먹을때 또 와이프가 맛있게 먹어줄때 바로 그맛에 낚시 하는거 같아요~",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugxl8ZqzQyFpsxK3exh4AaABAg",
  "author": "UC-wg6prUXmTiDq6n3AsYAmQ",
  "text": "재밌게봤습니다\n산남은 어디인가요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxzjxCEAP0oE7mGhzh4AaABAg",
  "author": "UCELtrOgq5gpZr2LJxQcKfFA",
  "text": "회뜨는 모습에 전문가의 느낌이 확오네요\n집에 복귀 하시면서 당당하게 '그릇'한마디에  듣는 사람도 으쓱해집니다 ㅎㅎㅎ\n좋아요 꾹",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugw59ugiJB-w0y4EJTB4AaABAg",
  "author": "UCcEzgUkSYwempZeb1M2srIQ",
  "text": "와 저번에 통발편부터 재밌게봤습니다\n저도 제주도여행중인데 포인트한곳 알아가네요\n시간날때 제채널도 놀러오세요ㅋㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzNsf1fnpjaurygojh4AaABAg",
  "author": "UCpTzFck_zYCbKRHi9DsCcBg",
  "text": "두분이 행복해 보여서 참 좋습니다 ᆢ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxdH_t7DE-HMS2RjAZ4AaABAg",
  "author": "UCZbTS_QpZwC7G80W0VoRoNw",
  "text": "흐미 날개를 회로 드셔야죠ㅜㅜ\n라면에 퐁당하시다니 아까워요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxC4CIq9NycS9aY_cp4AaABAg",
  "author": "UCcDFxwHFto4pxDGcmJZ4PCQ",
  "text": "헐..  귀때기가 젤맛있는데 그걸 라면에ㅠ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwbKFqQ4Kfb9ZgQrp14AaABAg",
  "author": "UCZeEmysHQTBdvqBwHrmv5bA",
  "text": "오늘도 꿀잼~ 시청 제주 역시 멋지네요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyzZGDaVtl0DFJW1DN4AaABAg",
  "author": "UCxvCXxvyDi06RxxzmHwCtLQ",
  "text": "잘보고 있습니다 보기 좋습니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwcM6Ns5HsDnk5P_uh4AaABAg",
  "author": "UCYQ1N48FiOixlRo87eutvlg",
  "text": "내가 이분 덕분에 포인트도 많이 알아서 가보구 정말 감사드립니당 흑흑\n(남해에 있는 곳은 다 가봤습니다)\n물론 가져온 쓰레기는 치우고 갔습니다!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzBc88BC8jRQrVryeR4AaABAg",
  "author": "UC8ZkUMdugJOjT7J6-Wb_iHA",
  "text": "굿굿~~~축하드려요^^ 아 슬슬 부럽기 시작하네요 ㅠㅠ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugzoe-fU53souGtNHph4AaABAg",
  "author": "UCy_vPVwF3n-rRYslJLQuPeg",
  "text": "꽝쳐도 매일 영상 올려주세요~(^-^ )\n아놔~제주살면서 제주 낚시 다니시는거 영상보고 있으니 좀 이상 야릇 하네요~크크",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugyqwmb3AAiRE9kXIFJ4AaABAg",
  "author": "UCxs-NFuGqSKhXLoP7UHNSGw",
  "text": "항상 잘보고 있습니다..\n응원합니다~~^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwXK8IX8KFQB4cZSvF4AaABAg",
  "author": "UCNIP5gNnaJ1Ocngx4yZlTWg",
  "text": "\"할만큼 하고 온나.\"\n크나큰 응원입니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwK1rIoI2UUlJ4cAy94AaABAg",
  "author": "UCELFLPJdCUPzyBB8fvEkPqA",
  "text": "첫무늬오징어의 맛은...못잊죠 ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyAnA4Wc5xioHiyzUl4AaABAg",
  "author": "UC7JChkrx4SLkKkJwoGYjwrQ",
  "text": "직접잡은 라면에 회라니...\n완전 맛있겠네요 ㅎㅎㅎㅎ\n손맛부럽습니다!!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz-8WeXzyb8K4b-Pyl4AaABAg",
  "author": "UCsfMxmZlaW2HT7AWkwXuaLg",
  "text": "역시 제주도 환상의섬입니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugxw6BueuwIKB4IntT54AaABAg",
  "author": "UCgSckU0T8wc6Pw6G0QThOOQ",
  "text": "저는오늘애월같다가  꽝치고왓네요  낼은그쪽으로 출도할까하네요  낚시하시는분들 다들 대박나세용",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzljS4X0syXStxpKwx4AaABAg",
  "author": "UCkZbIjco3GN9urIdjPL9y_A",
  "text": "오징어회랑 라면.. 맛있겠다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxauPUIojY3EQAQlVF4AaABAg",
  "author": "UChU8CyCf_qqWnd3QTU7NL1Q",
  "text": "신양포구는 안나오겠죠? ㅎ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwV1yrAovsK7AVfp8Z4AaABAg",
  "author": "UC92-yQjIpv_L7SFSuOdBDXg",
  "text": "짝짝짝 맛나겠네요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw3hGGO3ytgjzZSp7B4AaABAg",
  "author": "UCDk6Hqdxv7yskEJ8AOXojnQ",
  "text": "무늬오징어 잡으러 제주 가야겠네요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgznCpSW-h0oxDSIL6d4AaABAg",
  "author": "UCYd8gt_vxpGO0Hqi9rKxuKQ",
  "text": "앞으로는 날개를 회로 드시길....더 맛나요...",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxInSinGqknWLHTebV4AaABAg",
  "author": "UCCbE9N3OJkNbXx7yJqXvAdA",
  "text": "이열 죽이네여",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwsRjCmISXEfRm-5614AaABAg",
  "author": "UCh_ZPcHQdrup3ZoJTNrDE_g",
  "text": "캠낙여지도님 제가 2일뒤에  강릉에서 루어 낚시 할 것같습니다. 어디가 좋을까요?\n텐트도 가능한곳이어야합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxLSBiCVCrAKwsXztB4AaABAg",
  "author": "UCV6ZwVAO5eJ_mjfsPtXi4Bw",
  "text": "바닷물로 손질해야 더 맛나요 ^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz3YfK28ckCb5w2BGp4AaABAg",
  "author": "UCxQG5FshGkR28_nys6Ea-jQ",
  "text": "멋지네요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwZdpG6cCPyfUxKZFV4AaABAg",
  "author": "UCy_vPVwF3n-rRYslJLQuPeg",
  "text": "아....무늬까지 잡으셨으니....이제 제주 낚시 반은 하셨네요....(^-^ )",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyO-I8JqzoWCQ2Ezmd4AaABAg",
  "author": "UCWM__u8nWRNekuBqxqZAFAg",
  "text": "내일 보자는 말이 제일 감사한듯 한데요 ㅋㅋㅋㅋㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwcsncIkH1yA9yZgDR4AaABAg",
  "author": "UC82UVk-MPsV5Uie-frR2T3A",
  "text": "전 귀만 회로 먹고 나머진 반찬이나 쪄먹는데...안타깝네요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugxd8hf_iqyU9Yu8TYF4AaABAg",
  "author": "UCEdjTxuPJdmzvqQPAcsXhig",
  "text": "DTD  에기네요 ~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugy7shXUUAoHNU61fi54AaABAg",
  "author": "UCacPGJjuKOevNQWEGa3BxsA",
  "text": "사모님이 아주 좋으시네요ㅋㅋ낚시유투버 아내로써  최적의 성품을 지니셨네요ㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxZVSe2FlrTe4ErYmt4AaABAg",
  "author": "UCrDHJi3BcsW11Vvm3LFwr1Q",
  "text": "dtd에기 내요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgztZqBJiZ_cM2T0N1t4AaABAg",
  "author": "UC6_xPCKuduqD4BVImi1i5Sg",
  "text": "제주도민만 아는 포인트 제대로 알려드릴까요? \n100발 99 중 포인트 있습니다.\n서귀포 위미리 00 포인트 입니다.\n정말  다른분들이 모르면 해서 알려드리는겁니다.\n당장 내일 가세요.\n연락주세요. 방송분량 어마 어마 합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw03Cs1C9wFFAXS7fN4AaABAg",
  "author": "UCcjoXGIH2ih9rQo3jtgfxMg",
  "text": "오늘 이시간 저녁에 나가도 나올까요? 이날씨에요 ㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyOl3sGY35tEdpHFIN4AaABAg",
  "author": "UCcETc6Yb6Q9CedySLvkB_-A",
  "text": "지느러미를 회로 먹어야죠",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugwr8UHlw4-8qe6jngJ4AaABAg",
  "author": "UC9uTJfvhHgejpvJQTzNvZ2w",
  "text": "어설프지 않아요 ㅋ...",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwYoCJO4u9T0a1nyIR4AaABAg",
  "author": "UCUk1kZEUEzcyi_k2mrPIkhw",
  "text": "사시는곳 앞에 하얀색 조립식 주택잇죠??ㅋ 올초에 거기 세나왔길래 집보고 고민하다 말았는데....그 집 뒤에 사시는군요..ㅎㅎ 낚시하셧던곳 근처에 괸찬은 포인트 더 있습니다. 다음에 동출 함 하시죠...ㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy6rBJCvF1M3SvQ1Jp4AaABAg",
  "author": "UCxTykrbNkp4IbNWmRRX1oAg",
  "text": "달달한 무늬회가 최고지요👍 제주 부럽네요ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzRywLIo3JGzpuVEkR4AaABAg",
  "author": "UCl6UaW11F_qxi5TBLDSTKdA",
