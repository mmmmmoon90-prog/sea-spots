  "is_creator": false
 },
 {
  "id": "Ugy-bCt4PWAuRMla5cJ4AaABAg",
  "author": "UC_oshac5FUKpilCi32i7A3Q",
  "text": "갑오징어 정보 감사합니다 ㅎㅎ",
