 },
 {
  "id": "UgzcgZw7-irHiFWlFVN4AaABAg",
  "author": "UCvFhUNP_Le428xc2Npo4BoA",
  "text": "예쁜 바다닥TV~^^",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw37LqCse3lJK1XvTV4AaABAg",
  "author": "UCNYZOfpAIRKuEc7CVbffU5g",
  "text": "목소리 이뽕~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyIXk9hzUJbp_M6Zi14AaABAg",
  "author": "UCFoum73NIhiazOKyRdKMaFQ",
  "text": "항상 잘보고있습니다! 혹시나 가족과 더불어 1박2일 펜션을 이용하면서 편안한 낚시가능한곳도 알고계신다면 추천부탁드립니다!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxxjaJl1GHQLuYCwvJ4AaABAg",
  "author": "UCnyTd0a9e58RQ2s19z6Nfow",
  "text": "요기 시간나면 가는곳인데요 갑하러오는분 많지만 한번도 잡는거 못봤고요 보리멜 양태 도다리는 나와요 그리고 저번 일요일 통발을 깔더라고요 불과 몆미터 안에요 원투는 무조건 걸려서 낚시가 안되더라고요 다른곳을 알아봐야겠네요 이제는",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugyu5vdbVwQHLkjXvot4AaABAg",
  "author": "UCJdYQCkm9W90gnELHGxfFCQ",
  "text": "물양장에서 낚시하면 안 됩니다. 어민들이 못 하게 합니다. 그리고 밑밥 사용은 왼쪽 끝부분에서만 가능합니다.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxlvDOMe7D7BKqEPjJ4AaABAg",
  "author": "UCc-yQ5VFtvOKzHr3oAIoMgQ",
  "text": "그렇죠 뭐 어민들이 생계를 핑계로 없는 권리를 행사하는데 개인도 취미 자유를 보장받을 권리도 있죠.\n역시 포인트 소개는 제일 깔끔~",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "Ugy9Rf37VGH7svYM_q54AaABAg",
  "author": "UCeexpWt-HkWkslhcZq7-A3g",
  "text": "구영에 갑이는 안나올텐데 흠......",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxeBC4fpRszaVvSmxp4AaABAg",
  "author": "UCjM4gHbKnKDckt9F0NYEzhw",
  "text": "다음주 갑오징어 나올까요?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzIkUx_yNyR4AOsRlN4AaABAg",
  "author": "UCbnFDvHpQ4s14KHMPf-TAxg",
  "text": "벵에는 안나올라나요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzeYgnAqYBf0LI4YVd4AaABAg",
  "author": "UCgJnLv_ONhqCSPKaAi8fTfw",
  "text": "구영은\n낚시하기는좋은데 밑밥투척금지\n이장이 자전거타고\n밑밥투척시 난리남",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugzmga6aneG2JQC87Ul4AaABAg",
  "author": "UC4pkfjNVzaSyXCY4x508T_g",
  "text": "어민들 폐어구 ..그물같은거 제발 바다에 좀 버리지 마세요. 생태폐 파괴는 쓰레기 버리고 가는 낚시인이나 행락객 들도 문제지만 어민들이 더 큰 문제입니다. 돈벌이에 눈이 멀어 싹슬이 조업하는것도 마찬가지구요..",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugzh7YUgGePNq8ieUUB4AaABAg",
  "author": "UCKS7J-ZacEp9CyI90BitjIw",
  "text": "낚시인들은 아직이지밀 변화하고있는게 느껴진다 \n어부들이 문제다 바다속 쓰레기 전부 폐어구다 \n고래도 죽고 고기도 죽는다 \n어부들 낚시꾼 욕할자격있냐?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzYQ7QuKECDzXzAOkJ4AaABAg",
  "author": "UCqoFA9F7AFVj4HEVUXXo7nQ",
  "text": "어민들도문제가있조",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx_PzGDaOXNep15-V14AaABAg",
  "author": "UCqoFA9F7AFVj4HEVUXXo7nQ",
  "text": "무조거낚시하지마 참나",
  "likes": 0,
  "is_creator": false
 }
]