[
 {
  "id": "UgzCItBsmI3l9DbzjMh4AaABAg",
  "author": "UCo0Elskxe-NDMlkqrQL1bpg",
  "text": "역시 작은것은 어자원보호차원에서 방생을 해주시는 미덕이 보기좋습니다.  좋아요 누르고 갑니다",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgwGgbFnQXSh6o6vjvN4AaABAg",
  "author": "UCCD7sP8bcIReAkLixl0bmbw",
  "text": "안전한곳에서 문어 낚시 꼭 해봤으면 좋겠네요~~^^",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugz9o4R7SIHRp96TRal4AaABAg",
  "author": "UCdmGPXXfVTicCIsLNy0mkpw",
  "text": "영상의 정보가 도움이 되었다면 좋아요/댓글 부탁드리겠습니다 ^^\n너무 더운 날씨에 집중력이 흐려져서 영상 뒷부분에는 촬영이 원활하지 못해 영상이 급 마무리 되는 느낌이네요 ...  🥵",
  "likes": 0,
  "is_creator": true
 },
 {
  "id": "Ugz-cB85rgO1QVMs7J54AaABAg",
  "author": "UCcRqLHqI35SLLemsZwmWbLQ",
  "text": "13,14일에 석방렴에서 낚시했던 일인입니다^^\n대체로 문어가 작긴했습니다\n마리수 추카드립니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugz5cHK4N2LA-bZZq-14AaABAg",
  "author": "UCTDcwq5PS9oRxGWAI7Gg6_A",
  "text": "날씨도 더운데 고생 하셨어요!!!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwvCzMDRbaICzzyhe14AaABAg",
  "author": "UC8ZkUMdugJOjT7J6-Wb_iHA",
  "text": "ㅋㅋ 꼭 바칸이나 살림망 안챙기면 잡혀서....좀 당황할때가 있죠 \n저도 항상 그렇습니다 ㅋㅋㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzrAlt5JL9M7CRHQKF4AaABAg",
  "author": "UC-L8UP1mJ8jygGTnGt-Lj1g",
  "text": "선상 문어 가서 문어가 통발을 거꾸로 밀고나와서 도망 가버린 경우도 있었음 ;;",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwDqAMo2BZHTKqwCCR4AaABAg",
  "author": "UCiq0_rTLodGoC6FDzypOjFw",
  "text": "와~남해가면 저쪽 조용해 보여서 가볼까 했는데..이제 사람 많겠네요..ㅎㅎ문어 맛있게 드셨나요.ㅎㅎ물고기는 있던가요??",
  "likes": 1,
  "is_creator": false
 },
 {
