[
 {
  "id": "UgwjU3h_uBSV4FJHH2h4AaABAg",
  "author": "UClaxY_WCR4CJnQfa_bm6jKw",
  "text": "참 노고가 많으십니다..\n부부가 행복한모습이 넘좋네요..선행이 많으시니 복받으실거에요~\n항상 응원합니다..수고많으셨어요~😊❤",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxuzitZR5UzkKYlS194AaABAg",
  "author": "UC8ek5Hfg_Yv9lELTP6btOrQ",
  "text": "좋은 영상 감사합니다~~😊넘 멋지고 좋아요.노을도 끝내주네요😊",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxkvlfsKu0gJDFjReR4AaABAg",
  "author": "UCZXPlFZoMow_2lUqfAli9bA",
  "text": "화장실도 있고 좋은 노지캠핑 지네요 오늘도 영상 즐겁고 재밌게 잘 보고 갑니다 행복한 하루 되세요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyTfQSSKEhBufHhLfZ4AaABAg",
  "author": "UC9AIn9LdsdkywBwVUVfmdeg",
  "text": "멀리까지 가셨네요. 흔히 볼수 없는 서해바다에요. 우왕. 두분이 다니시니 더 좋으시겠어요. 노을 🌅 진짜 멋쪄요👍🎆",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgxsoivO1walBD6743h4AaABAg",
  "author": "UC-0dIpCl36-AIcAriYGPRow",
  "text": "와~~~ 멋진 곳에 다녀오셨군요. 즐거운 차박여행입니다😊😊",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzrXUUKlXbDl73VxSR4AaABAg",
  "author": "UC3o61GCcq6r8r32cmPjc_XA",
  "text": "깔끔한 맨트와 영상 감사합니다^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugyv2ihUCPzwJHGmnrB4AaABAg",
  "author": "UCFRBuNFU4K-0yO3KxyqsKmw",
  "text": "말씀하신대로  노을이 대박이네요❤\n저도 가보고 싶은데 거리가😂\n싼차박님 영사으로 대신하죠\n언제나 좋는곳 소개 감사드립니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyfrRgP9ZOY5_OFDV54AaABAg",
  "author": "UCH3MgToqcbOrtQQXaU9dOfQ",
  "text": "벡바위 또 들러보고싶은곳이에요.\n너무 좋아서 1박하려다 2박을 했어요.😊😊😆",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugwbcv5CJzwY9PjobSl4AaABAg",
  "author": "UC-cswIB_Tiqm10H8G0Gvq7Q",
  "text": "노을 진짜 멋있다에 한표😍",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwKKmE43JgSnLIhe8V4AaABAg",
  "author": "UCoDk1yTT3YgqQrf1J_9uiwQ",
  "text": "노을이 너무 이쁘네요..",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx55UzMgorliM8Rs3d4AaABAg",
  "author": "UCVwFE1FXOBuI2PpHycnrZRg",
  "text": "자세하게 말씀해 주셔서 감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxCtdNyTY-myOCthFB4AaABAg",
  "author": "UC3Ns7S_2j2kKgEv3Ebh21BQ",
  "text": "영광까지  우와  ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwlCcJkJkjlBQvqkW94AaABAg",
  "author": "UCBNt_NGrHIH6FVAC-ctvBZQ",
  "text": "😂멋진곳소개감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugwxnz82md3zV78rPzB4AaABAg",
  "author": "UCVFbtoJpajSmxaFuX37uQgg",
  "text": "_영광까지 영광입니다~~**_",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyLfBI6ewdBS3Aoc3F4AaABAg",
  "author": "UCuB14laEu8nYfEqMq7P-qqA",
  "text": "막걸리 진짜 좋아하시나봐요?😊\n저한테는 좀 멀지만 좋은 차박지 알려주셔서 감사합니다🤗",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxldsNsUBaFTDCWRgt4AaABAg",
  "author": "UCcva7AKHLugdWhETQvTMxvw",
  "text": "첫화면에 왠한자가 쓰여있어서 중공인줄알고 놀랐음\n한자가 위에 하나로마트는 밑에쓴걸 어떻게 이해해야하나",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxPjKIA98uT9JfMn5V4AaABAg",
  "author": "UC3PICpdUxs7J2OGq_Zad7aA",
  "text": "물이 항상 없나요?",
  "likes": 0,
  "is_creator": false
 }
