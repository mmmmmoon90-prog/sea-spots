[
 {
  "id": "UgwKVgvPJI3LvlIhkQF4AaABAg",
  "author": "UC3JMZEMrRp0PEiyFnDZAAVw",
  "text": "구영방파제네요.\n고기 나올때는 발디딜틈이 없고,\n텅비어 있으면 고기도 텅빔...",
  "likes": 9,
  "is_creator": false
 },
 {
  "id": "UgwLIOrYIIG_jF4yGMR4AaABAg",
  "author": "UC9JiGIal79VNJZLVPmPvJDQ",
  "text": "여기는 감성돔이나 낚시할때 미밥 못쓰는 방파제입니다 갈치루어 백조기 갑오징어 볼락 나오는 포인트입니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzceAaxnXxSh5fJCtd4AaABAg",
  "author": "UCJ7zD6nrkTg8ag0OFkmqw_Q",
  "text": "듣다보니깐 아기프로그램 인줄알았네요~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxRrYoF3Kd7Wvt1kPZ4AaABAg",
  "author": "UC_CSCiRGIyRsTBaDsmZNaKA",
  "text": "거제권 갈치낚시로 명포인트죠 ㅎㅎ",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "Ugxc3IUnpoM_mcJ61Hx4AaABAg",
  "author": "UCv-0dYfr24ErQX-gsm68MhA",
  "text": "ㅎ 이번휴가에 가볼께요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgztAbL-phV5NWwK1354AaABAg",
  "author": "UC1lOGn3KZr9PcsohwUuSP1w",
  "text": "해요~~ 💕",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwRf0QRV55E6_yZrct4AaABAg",
  "author": "UCfycxqaKp9x1GOBjuf--wMw",
  "text": "저기 지나가다봣는데 밑밥사용금지 적혀있었던거 본거같은데",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxCl2QV28-5zRHPTJ94AaABAg",
  "author": "UCxIk4gF1Lgtxcpzr6SfFVFw",
  "text": "캠핑은 좋으나 고기가 없다. 낚시꾼 없는 방파제",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxJx2gZTOKUUO2vMoF4AaABAg",
  "author": "UCBmiPy09AHUz8z1tz4AlWpw",
  "text": "여기 지금 사람도없고 고기도 갑오징어도 4시간째 읍어읍어요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyP0Y36xNHZsYRy8rp4AaABAg",
  "author": "UCQ_9sEA0jp51hSWM3LbNEbg",
  "text": "구영방파제이네",
  "likes": 13,
  "is_creator": false
 },
 {
  "id": "Ugz28EPZWQvpJX4TV4F4AaABAg",
  "author": "UCXmqgbnJDQo3TBW5WQ01X3A",
  "text": "호레기도. 올라오던데\n이제는 모르것네요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugz_-Dnl3ySCTcR-ral4AaABAg",
  "author": "UCOSwtIa5GS7Sy8dmfdUB3LQ",
  "text": "바다닥~🐟",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwRx9w2zS_NC6IbO-p4AaABAg",
  "author": "UChiVHJUzQI3KuexR5nZhaRQ",
  "text": "화장실 이 없어 빵점이야",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyALja8ZxqVKfTJhj54AaABAg",
  "author": "UCJCHaVDJG_D2NzxJqt2H-xQ",
  "text": "좋아요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyqeKJBPJcviCB1Glp4AaABAg",
  "author": "UCUQ3qwqdSGq7tNg5fObXhug",
  "text": "땡큐  !",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgypApZBVE9tqo8ok_V4AaABAg",
  "author": "UCyGQkpmgqXZWsFcbEXWHcog",
  "text": "요기가 어딘대요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy9z0GhFYCNC4NmI7x4AaABAg",
  "author": "UCTQWKdY_LCr2MK-IzLpORkA",
  "text": "지금 백조기나옴~",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyuXcvvfNTpVlIA0a94AaABAg",
  "author": "UCHeaRJTl_YNlcR1wgOjDKXg",
  "text": "여서헷는데 고기없음",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugza2Oj6iwcivCwXieZ4AaABAg",
  "author": "UCPDYQ4VX5jV0HTpysLm5mdQ",
  "text": "어떤 생명체가 나오나요?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzYylKIydkwGWt-BGR4AaABAg",
  "author": "UCamyXWquICtymEWCD63X8fQ",
  "text": "다 좋은데 편의점 낚시점이 없는게 단점이지요...",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgztP6j0zznSF--s4FF4AaABAg",
  "author": "UCaxJpp4EXSlUB_leYJ5vjCA",
  "text": "여기가 어디에요?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzsKaqSSmmSlPAzWkx4AaABAg",
  "author": "UCgJnLv_ONhqCSPKaAi8fTfw",
  "text": "구영낚시안되는데.발판편한거는\n맞어.주민들\n물속에 밑밥투척금지\n하다들키면\n안좋은소리함\n서로 인상 써지말기를.\n갈치는째끔잘됨\n요기화장실은\n개인화장실필요근데주민들이바보죠,요즘화장실\n정부보조로다설치해주고청소도\n군에서다하는데\n주인들바보들만사나,부산기장,\n일광바닷가가보세요,화장실청국임니다,깨그싼화장실노래도나오고물도철철\n기장으로놀러온소,",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "Ugwa0ZCD6fDFhWdd3yp4AaABAg",
  "author": "UCT1OYKSFpeTdiKd2GLU7RHg",
  "text": "구영인가볘",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugz8dM7QD-JsonD6gr94AaABAg",
  "author": "UC8v5MQFh4tYdGSB5sy0sZVA",
  "text": "어차피 사람 치여서 낚시하기힘듬ㅋㅋ",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgzlOQM8KdD31BSjKzt4AaABAg",
  "author": "UCQSVdPn3Qg-oZeCJ16WeQSQ",
  "text": "화장실은 없나요 ?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxHvxK788l9TKEyj8N4AaABAg",
  "author": "UCLMQNCTSDf5KgHn4PmB2MgA",
  "text": "화장실이 없는거 아닌가여 그럼 좋은곳이 아닌것같아요 ㅎㅎ",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "UgyhvPf5hmPZSaipCY14AaABAg",
  "author": "UCt4Yf95HxgUJP3w4fpFf2SQ",
  "text": "밀물때 텐트 싹 쓸어가는 해수욕장",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwELGzwNuQQYGgHXrt4AaABAg",
  "author": "UCO76uSDg1v5zxaeErlKCSEg",
  "text": "어부 배타고 웃으면서 낚시줄 끊고 도망간곳 이내요 인심 한번 역대급",
  "likes": 7,
  "is_creator": false
 },
 {
  "id": "UgxjUa4k1wVYnnMbAFN4AaABAg",
  "author": "UCKla7IVVrkXsntDQvcwdi2g",
  "text": "거제도  대부분 동네앞 방파제  주민들  음식쓰레기  생활 쓰레기  바다에 버리고   낚시객  쓰레기 버리지 말라고  현수막 붙어있음",
  "likes": 29,
  "is_creator": false
 },
 {
  "id": "Ugyq-DiLsrIKI8ggFjp4AaABAg",
  "author": "UC6XWm8dVlxmgJvp7WonT0GA",
  "text": "고기없다. ㅋㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz_Wc5fB8pFh74apQ54AaABAg",
  "author": "UCBy1s3VJkxsIVS43K_-LWdg",
  "text": "영상 잘 보았늡니다 혹시 여기가 구영방파제가 맞는지요?",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgyEqOAow4SGSWsDQbR4AaABAg",
  "author": "UCh4gTW70oZNZcDbTalKM0OQ",
  "text": "방파제 자기들 돈으로 만든것 처럼  유세 떠는것 보면 어민들 지원모두 끊어야됨.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxCeUqngOTxaZj6aN94AaABAg",
  "author": "UCyGOK3GdVrn9VKsm5jWWZtg",
  "text": "고기없는 방파제임",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "UgxaHJbMwC-zpNKJ3Q54AaABAg",
  "author": "UCj8-ERddELw1E7jT6H9PflQ",
  "text": "바다에 밑밥도 못치게하는 방파제네\n바다에 밑밥뿌리면 어민이 상욕 합니다\n밑밥으로인해 바다속 오염되서 조개죽는다는 말도안되는소리. 시부리먼서ㅋㅋ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwvcEzRgvbxWvBlMc14AaABAg",
  "author": "UC-28Q07ZgaC5v0ZE3csos1g",
  "text": "수도권에서 가까워야 가지...화성 서산 안면도 정도면 몰라도,,,수도권 2,000만명중에    게제도를 누가 가냐...",
  "likes": 1,
  "is_creator": false
 },
