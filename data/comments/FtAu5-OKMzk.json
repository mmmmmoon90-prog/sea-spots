[
 {
  "id": "Ugwsd-f0P6aJ-RfdZm54AaABAg",
  "author": "UCOGV2o0UHVaXDj2D1gpgv2g",
  "text": "아름다운 금수강산 감동적인 영상 감사합니다.\n새해 복많이 받으세요.",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "UgyxhaHUGbRF03Wb4Dh4AaABAg",
  "author": "UCLWYnRW4cHXCGwGDdZJuhaA",
  "text": "라라님!!!~올해20만가즈아!!!~새해복많이 받으세요 ~~❤❤❤",
  "likes": 6,
  "is_creator": false
 },
 {
  "id": "Ugx4INIO1bBUw78ekTV4AaABAg",
  "author": "UCNAuILWMvi-mU8dPX9MjDQw",
  "text": "항상 건강하시고 좋은 일만 있으시길 기원합니다 ,\r\n아주 좋아요!!! 항상 응원합니다.",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgzfNwZCsANqyaeJCdR4AaABAg",
  "author": "UCBDhNzIOIuOgcP1jvQRzHdg",
  "text": "지난해9월에1주간캠핑했는데 조용하고좋아요명사해수욕장파이팅",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgxKf9_P27d9QD3YWHN4AaABAg",
  "author": "UCpDH7iLbxXwSlKPewYnkFUQ",
  "text": "안녕하세요 명절은 잘 보내셨나요 연휴 마직막날 사람냄새물씬 묻어나는 라라님의 소개 맨트로 아름다운곳 착한곳 \n잘 봤습니다 늘 건강하시고 행복한 여행되시길 기원해봅니다 감사합니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxPp-TOhmnwLNl_cZd4AaABAg",
  "author": "UCxfvwQPpIUSDyPIHfQqACNQ",
  "text": "좋은 정보 감사합니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyzIBuKx_6heiA6dDJ4AaABAg",
  "author": "UC2trtP084CkQuJZO3CfwENg",
  "text": "몇년전 여름휴가갔던 곳이네요\n아가들과 놀기에도 해수욕장이 멋졌던곳 주변펜션서 자며 즐겁게 놀았던 곳이네요\n부산에서 가면 거제 끝부이라 멀긴하더라구여 또 가고싶네요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugw8TV_bD-QvVjgEn5l4AaABAg",
  "author": "UCrkOzos4JrkGD01llFSUpDQ",
  "text": "명사해수욕장 너무 좋죠~  \n지난주에 다녀왔어요~^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxN8nSYGOLyY1mSDdt4AaABAg",
  "author": "UCHXR1Sx6N3oT2YVjcaWXPAg",
  "text": "좋은 곳 소개시켜 주셔서 감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzptIaZuRzAxZJePmV4AaABAg",
  "author": "UCDZYjjiRz_4MC89NqZj3awg",
  "text": "난 너무 멀어서 가기도 힘든데 라라님이 알려주니 가고는 싶네요, 좋은 정보 감사합니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzuCq9lJ3ga1_q28lJ4AaABAg",
  "author": "UCXswK1dbmLAu8O0RlK8mblg",
  "text": "항상 잘보고 있습니다  새해복 많이 받으세요 ❤",
  "likes": 1,
  "is_creator": false
 },
 {
