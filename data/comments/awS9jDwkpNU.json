[
 {
  "id": "UgwybqaUKmAaPgk7jUh4AaABAg",
  "author": "UC2-KLsEV-2AF4r0uxjJy8gA",
  "text": "일단 탁 트인 경치가 끝내주내요...\n\"거 경치가 물건이네!!!!\" ㅋㅋ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzoE4ifSNM-NrqZ-jN4AaABAg",
  "author": "UC4U7swnWq6xOJKy4UOi2P3w",
  "text": "영상제작정보감사요~^😊😊😊😊😊",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzGTTMoEXXlgFYTb354AaABAg",
  "author": "UCV14Q58ItuyfAeAWKMD3Bgg",
  "text": "감사합니다🤩",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzY3oqMq4ZLpOPwwdJ4AaABAg",
  "author": "UCggLPVs6tc1qJsvP6GlbLow",
  "text": "반갑습니다 😁오늘도 좋은 정보 얻어 갑니다 감사합니다 ㅎㅎ 항상 즐거운 시간 보내세요 🤝 😊",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxG49MDoeoxunVawV54AaABAg",
  "author": "UCe6i1ZCXhJ0fOfh4xGFu_pg",
  "text": "석축쪽은 안전하고 편한하다고 생각하지만 낚시 장비 운영면에서는 더 불편 할 수있어요 석축이 높고 멀리 뻗어 있어 한눈만 팔아도 원줄이 석축에 걸려 장비손실이 많은편임",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxKsnJUupHm5IkVfSN4AaABAg",
  "author": "UC1bR5dOSVtaikiWsZNxJ4Cg",
  "text": "낚시 포인트 소개 유튜브군요.\n감사합니다.\n자주 애용해야 겠습니다.\n명절 연휴 즐거운 나날 되세요.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz1waFY3JD9cdyMcFF4AaABAg",
  "author": "UC9xxRvKu6ZXLSkJQsdW5iTQ",
  "text": "정보감사드리며 환절기 건강관리잘하세요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgznhKAtzOqBEOisSrN4AaABAg",
  "author": "UCshyJGDvRducu4ZW2E4m48w",
  "text": "자세한설명 감사드립니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy7wHhokDasoTnp9Fp4AaABAg",
  "author": "UCEfn_rwy-PoHd8psemlNFGg",
  "text": "열정은 아무도 못따라옵니다👍🏻👍🏻👍🏻  바쁘실텐데 감사합니당ㅠ\r\nㅎㅎ 코로나때문에 집콕중인데 영상 너무 감사합니당 !!♥♥  \r\n오늘도 멋진영상 주셔서 감사합니다!!💛💛💛",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgwnJRm4cqR0c01l90F4AaABAg",
  "author": "UCJAqFqIW7vV-KfZT1-zt0Rw",
  "text": "몇일전에 갔다가 볼락구경도 몬함 ㅠㅠ 엉엉",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgziJw05EetNKEbupc14AaABAg",
  "author": "UC-J8s1369LDYom7JpPsW57Q",
  "text": "낙시줄연결방법은",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugyy7soap8ntT85lNRx4AaABAg",
  "author": "UCPDYQ4VX5jV0HTpysLm5mdQ",
  "text": "제 개인적인 의견입니다만\n만조 2간전부터 만조후 2시간까지가 입질시간으로 보입니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyPJZABOZzBaf1UIQB4AaABAg",
  "author": "UCdHt2DYEgC2dySQC7cb6gEw",
  "text": "원투낚시는힘드나요,",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxWzS8diKL8FnZhMFx4AaABAg",
  "author": "UC2Td1eT_UnwJyO_dxy8w0Lw",
  "text": "흰등대..도보로 갈수있나요.갈수있다면 주차나 진입로가 어딘지?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwcxWkcQ5ZJjm6f_PZ4AaABAg",
  "author": "UCzfhLiMFsyBuSABqpxoZw-g",
  "text": "배편을 이용할려면 어디서 가서  알아봐야 하나요?\n그리고 배편 요금은 얼마인가요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxPLdVi5DPff0t5bdB4AaABAg",
  "author": "UCrgRJkk0Yue6wP5FBPQXRuA",
  "text": "여기 방파제는 화장실은 있나요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz3bYS5Flw2yPP5Y-54AaABAg",
  "author": "UCLePPC7vPX2UT-h4uCHOjAA",
  "text": "물건방파제에서 벵에돔 안나옵니다 이제 감성돔시즌 잘나옵니다",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgzTHWpomBFWZ-NwYFx4AaABAg",
  "author": "UCdHt2DYEgC2dySQC7cb6gEw",
  "text": "원투낚시 는 못하나요?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugy09pSszfsxYYwXHJh4AaABAg",
  "author": "UCdpZMCMbiWRQNhX3-n6SFMQ",
  "text": "방파제를 오가는  선비는 얼마입니까",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugx76lPw0tg4hPb3PiZ4AaABAg",
  "author": "UCX_YjNN4Lj56FUwrn20zI3w",
  "text": "저기 낙시할수있어요? 금지아니겠죠?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxD0OATvCz5in1Ox3l4AaABAg",
  "author": "UCOGulIDL6hhjUXloijSQ0IA",
  "text": "전어",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyrXy6IjiL0ZLHEVeF4AaABAg",
  "author": "UC-IltxJYiCGC4C9qm8PSfNQ",
  "text": "잘 봤습니다. 구독눌렀어요. ㅎㅎ\n근데...화장실이 없는데 왜??? 여성만 주의를 해야하는 걸까요? ㅋ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyBDvXx_ETaMvjFfyV4AaABAg",
  "author": "UCZZ728kgqR1aqITQtH6mv_A",
  "text": "물건항 안에테트라는진입금지…입니다..모르시고올리신거같은데… 벌금있습니다\n확인해보세요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyHAGIqLx6GmJ3RHhx4AaABAg",
  "author": "UCABpnjL1MuHavATAI6RPlyA",
  "text": "수심좀알려주세요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwKQWgz4YabOaMQBMJ4AaABAg",
  "author": "UCnw7Qm_d_Ub5qF3HCBWQ6rg",
  "text": "테트라를 일본처럼 안전하게 만들어서 사용하면 사고도 안나고 좋을텐데 아쉽네요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugz5wxcWzcoMCi0R6jJ4AaABAg",
  "author": "UCYy5d9XfsJxi9MFVbN4cJzg",
  "text": "여기는 테투라 위험 위험",
  "likes": 0,
  "is_creator": false
 }
]