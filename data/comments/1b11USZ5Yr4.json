[
 {
  "id": "UgxEJaP2ijQlGnoYLKB4AaABAg",
  "author": "UCkFYoZTsYNykzlQY4IN5Wqg",
  "text": "늘 감사합니다 많이 도움됩니다",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "Ugyf5YrsIx1TS0QZkyp4AaABAg",
  "author": "UCOGV2o0UHVaXDj2D1gpgv2g",
  "text": "우리나라 갈곳이 정말많군요.\n멋진곳 감사합니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxNXeLtGmc7sbHCv5B4AaABAg",
  "author": "UC0afB3HJQWwvdJsarAOhiXg",
  "text": "우리 명사십리해수욕장을 \n이렇게나 영상에 잘 담아주시다니 감사합니다\n꾸벅~^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwF4Ah-wejT8P75DFN4AaABAg",
  "author": "UCEKOwcMSzLvDjbEqlpfRjsQ",
  "text": "멋지네요\n감사합니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugxbs4cgeOYcio0TbC94AaABAg",
  "author": "UCinNF_UieiScGr5uLThjp3w",
  "text": "정말 대단 하십니다. 퇴직 대비해서 르노마스타  기반으로 2년째 쉬는날만 가끔 다니고 있는데 퇴직하면 라라님 발자취만 따라 다녀도 몇년은 걸릴듯 합니다. 항상 감사한 마음으로 멋진영상 감상 하겠습니다. 두분 어제나 건강 하십시요~~~!!!",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxyCmCPJpbbr8XRNWZ4AaABAg",
  "author": "UCC3pQbPxKvzm8ZuhWwlRfzw",
  "text": "라라 최고",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy8fxG3ZHQvA5NbNTh4AaABAg",
  "author": "UCVQftQYe7YF2osJ6247JXBA",
  "text": "블루플래그!\n봄에다녀온그곳\n\n신지겨울은 한번도 즐겨보지못했네요\n\n올핸참고\n가을과겨울 완도권을‥ \n\n라라님등에엎고 \n이영상 추억하며 즐길까합니다\n\n전국이 봄을재촉하듯 비가옵니다\n\n뚱띵이끌어안고 빗소리들으시며 행복한시간되시길‥\n\n감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwAJxaQXmsLknR9lvp4AaABAg",
  "author": "UCtjDgKnAj6sWr8LnvG8AwxA",
  "text": "완도 명사십리 신지해변 여름에는 수많은 사람들이 모이는곳 한가한 겨울은 을씨년 스럽지요.  잘 받습니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyGf4D1SSjpW9ApAT54AaABAg",
  "author": "UClA1K9m8cJwPB3fKUMI8NNw",
  "text": "대단하십니다  감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzuWwDgjxD2keq3B7l4AaABAg",
  "author": "UC0mGf6NcB20s8Wu7ebGpNqg",
  "text": "감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzA71RExFeQJEbac8V4AaABAg",
  "author": "UCypjVJSbCbFjqfq3Wo_dQog",
  "text": "완도해양치유센터도 지난 11월에 개장해서 운영중입니다. 몸과 마음의 피로를 풀어줄 해양치유센터 꼭 들렸다 가세요.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugyx-5e_D7EJiYX-v4p4AaABAg",
  "author": "UCqXs3PoJBXw2Hh7XYRJSKCQ",
  "text": "ㅎㅎ   제가아는 차박전문 블로그는 라라님이    최고입니다  감사해요...",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugz5QJYHMWOyKwBuyaB4AaABAg",
  "author": "UCDwgssnGZPNCT1DPD2yK3FA",
  "text": "올 여름 휴가  완도로 정했습니다\n❤❤❤",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyWdBJVWR-B0K3Atp54AaABAg",
  "author": "UChN9EZYaL0BMQLs4ro2O3LA",
  "text": "감사  그런대 권역별로볼려면 어케보는지요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz5fzMRK8nDktblW914AaABAg",
  "author": "UC8ycB6c3DiWhHuD2xWue-cw",
  "text": "소나무 그늘 아래 텐트를 치려면 자리값 4만원 가량을 내야 해요;;",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxD3igfDhcmJkzyFA94AaABAg",
  "author": "UCp0DbQorNNeLh_lE8NbDbUw",
  "text": "25년7월9일 지금 왔어요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx3ZPbpmbxT43PoaJR4AaABAg",
  "author": "UCypjVJSbCbFjqfq3Wo_dQog",
  "text": "c구역 공중 화장실은 완도해조류스파랜드 옆에 있어요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgznFEumGOJeulX9tct4AaABAg",
  "author": "UC8vT1QiSXFJzz7UEUSkK70g",
  "text": "해수욕장에 샤워 시설이 있을가요~~",
