[
 {
  "id": "UgxZ2_mwR3mSwF9lJLd4AaABAg",
  "author": "UCkOXj55U_SXqRTBDHhSYeww",
  "text": "구룡포 너무 멋지네요. 차박준비중인데 내년에는 꼭 가보고 싶어요. 멋진 차박지소개 감사합니다.😊",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugy6ELQhL2AOu9kyLYl4AaABAg",
  "author": "UC9yI2HNN1wNDKthEFJxldCw",
  "text": "좋은 영상 잘보고 갑니다.\n수고하셨습니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxXKzU2bT0uSZViMQ94AaABAg",
  "author": "UCjOXWpZOEnqIe162vsdZGbw",
  "text": "아침에 보고 바로 구룡포해수욕장방파제에 와있어요\n라라님 항상 좋은 정보 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzXyAF3O6UNfdMLliZ4AaABAg",
  "author": "UCGuN0Xg7uotMSh1YTFSv-1A",
  "text": "컨텐츠가 이렇게 좋은데, 어서 100만 구독 갑시다!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyO01mXGCKF-lnOO4h4AaABAg",
  "author": "UCm1WwPtzl0eNhI2J6GXzp_Q",
  "text": "구룡포 너무 좋네요. 좋은장소 소개 감사해요😊",
  "likes": 1,
  "is_creator": false
 },
 {
