[
 {
  "id": "Ugyq4mizzOv85dvSLzZ4AaABAg",
  "author": "UCYhJcg4BcEXd3hckQ1yQzbQ",
  "text": "전국 무료 캠핑차박 300곳 영상지도 https://youtu.be/mQMCYrm8fa8",
  "likes": 0,
  "is_creator": true
 },
 {
  "id": "UgwLt014DDV9dbrqpZB4AaABAg",
  "author": "UCngK-RDnfhA8-VWz4p3EDyw",
  "text": "차박하는분들에게 명쾌하게 정보를 제공해주는 최고의 차박러시네요. 감사합니다.",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "UgyvYtEKGnUQg00BPVV4AaABAg",
  "author": "UCuQAwba-2XZESNyUaqf2OAg",
  "text": "와우 만명 돌파 축하드려요 🎉",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugw1WyR4K7ILWDUJkHR4AaABAg",
  "author": "UCBHNJ_L4PkUhAgPWb2j2Hbw",
  "text": "잘보고있습니다\n다시 바빠져서 시간내기가 어렵지만 이렇게 대리만족하고 있습니다\n감사합니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxTUTlzS6Tsx2u1WZN4AaABAg",
  "author": "UCSUWWwsSvnDJZtKsG8BUp-Q",
  "text": "거제도랑 진도는 제가 근무하는 회사 리조트가 있어 자주 가봐서 얼마나 좋은지 잘알죠 좋은영상 잘봤습니다^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugzg-azK8VABEN8l_UZ4AaABAg",
  "author": "UC9yH75IUy_ak-HTEA5FJdGw",
  "text": "귀중한 정보 감사드립니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwOrMjyrATLn62riSl4AaABAg",
  "author": "UCJsmTbUy-4BrED0twlOXSTA",
  "text": "라라님  늘 명쾌한 목소리를 들으면  나에  마음도  상큼해진다는  ㅎ     항상.늘  조은  캠핑 차박지   정보에  진심 감사해요\n 두분의 모습에  예쁘고   부럽구\n이번 거제도  여행에서  두분만남이   정말고맙고 감사햇답니다\n항상 응원 하겟습니다\n그리고  고맙고 감사해요~~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyJCGLJVWhx_KvfJKF4AaABAg",
  "author": "UC3Ro9iA2yHiQGDVOX0tm8DA",
  "text": "자세한 내용  넘 감사합니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyCHC9c0A0WdQeapUB4AaABAg",
  "author": "UCeokm775V7aQkJq9RliHLrQ",
  "text": "좋은정보 감사합니다. 항상 행복한 여행길 되세요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugy5Z3v4MeSuT6NA1HV4AaABAg",
  "author": "UCH1SBsbjaVEdKdfbGkbRfaQ",
  "text": "아름다운 남해안 풍광 입니다. 항상 감사합니다 ^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgynWmKDroRetQ4XcrV4AaABAg",
  "author": "UCOGV2o0UHVaXDj2D1gpgv2g",
  "text": "남해안 대장정을 이루셨군요.\n대단하십니다.\n눈길 안운하세요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwG5FT8QenHFySokcp4AaABAg",
  "author": "UCa7gcpV0Ssp4mJCo2023qMw",
  "text": "잘보고 갑니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzYZ9Uq1JRV7WTkK3F4AaABAg",
  "author": "UCoG0F1J-gwGWxT0tX_-4CMA",
  "text": "좋은정보 항상감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwUSlP7YRqsoGn-CSt4AaABAg",
  "author": "UCNRC-6L_gbkzUBc0yBa4C9Q",
  "text": "우와 정보가 많네요.구독합니다. 클린차박할게요~~♡",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwRJGozeZEjreXWDQt4AaABAg",
  "author": "UCPYv-FDaac9H4TKRVFO5yrA",
  "text": "늘멋진정보 감사드립니다^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyWsvPh0-XVjb82ht54AaABAg",
  "author": "UCkuLHcjViNLN57gAdDHed5A",
  "text": "대단하십니다...이번 한주도 파이팅하세요♡♡♡",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgylM5mNqfvRs-6W19J4AaABAg",
  "author": "UCfRGWtdrwRpqNJE6MNYQvsA",
  "text": "너무감사합니다 꼭 가볼려고 매모햇어요^^♡",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxaFm4y0x1_bynzc-B4AaABAg",
  "author": "UCE2VGWCAHI-q_YRYb84FyLA",
  "text": "여행 멋지게 했네요.~~^^\n이많은 영상 한번에 싸~악   멋져요.\n늘 좋은 영상 부부애와 함께...즐감하고 갑니다.\n감기 조심하세요.~~^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzGSUwetoc-_7Wp9sZ4AaABAg",
  "author": "UCRZKyCB-O3505L3IG7SIm0Q",
  "text": "안녕하세요? 정성어린 여행기 잘보고 있습니다. 다음주에 라라님 믿고 남해 열흘간 여행갑니다......",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwyZb07vzeLIaMotuF4AaABAg",
  "author": "UCcZeqeLnNj-sYAtbd1pKK7w",
  "text": "오늘도\n감사합니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugxs1GY6nJaybjWNbzN4AaABAg",
  "author": "UClSomyUiok8GmTCBaduAmvA",
  "text": "좋은곳 알려 주셔서 감사합니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxhhdCPA7bcozzgBMB4AaABAg",
  "author": "UClq1GOG11q7ZULN4pszO0oA",
  "text": "올핸 꼭 라라님 따라서 한번 가볼려고 합니다.",
  "likes": 1,
  "is_creator": false
 },
