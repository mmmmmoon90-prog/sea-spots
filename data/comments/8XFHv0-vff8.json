[
 {
  "id": "UgxX33vwL1mfJxu6tnV4AaABAg",
  "author": "UCdmGPXXfVTicCIsLNy0mkpw",
  "text": "정보가 도움이 되었다면 좋아요 및 댓글 하나씩 달아주세요! 영상 제작에 큰 힘이 됩니다!",
  "likes": 2,
  "is_creator": true
 },
 {
  "id": "Ugxwz8DuBKCGkWlG4IJ4AaABAg",
  "author": "UCVKfIkXqBRaNqFe67pS795w",
  "text": "추천해주셔서 갔다왔는데. 여기 캠카나 카라반 가지고 가시는분은 멘탈이 강하셔야 합니다. 동네분들 다좋으신데 거기 정자바로앞 골목에서 정신세계 독특한 부부가 2층에서 여기를 계속보고 있어요 특히 카라반이나 캠카 어닝펼치면 난리 나요 정자에서 돗자리깔고 식사하는분들한테도 게거품물어요 진심 멘탈날라 가요. 하루에 3~5회는 나와서 ×랄을 하면서 돌아다녀요 경치랑 환경은 진짜좋은데 동네 다른분들은 다 좋은신데 ....아쉽습니다. 멘탈강한분만 추천드리고 아쉽지만 기분좋은 휴가를 망치기 싫은분은 생각좀 해보세요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz_lmKG7oWW1p0gTid4AaABAg",
  "author": "UCSLvBaOKje9FGT0ipZNnq_w",
  "text": "여기에서 최근개봉한 영화 브로커 촬영도 했었어요.^^\n좋은 컨텐츠 잘 보았습니다",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugwj5wKf9DfxnETKxOp4AaABAg",
  "author": "UCQoJzSJuUtNTJCPTpKkW9zQ",
  "text": "좋아요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxobW1NvJMHRsSRkjB4AaABAg",
  "author": "UC8Cb0gOHhg8PKk8QQkSh9Yw",
  "text": "뷰가 정말 너무 좋으네요!!!왠지 주변도 조용하고 힐링하기에 굉장히 좋은거 같아요!!!",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugx1ipB_huQTbr0fAyV4AaABAg",
  "author": "UC5lVQYGI4Ba8jtyw5IMi_XA",
  "text": "정말가보고 싶은데네요 넘 머네요 항상좋은정보 감사해요",
  "likes": 0,
  "is_creator": false
 },
 {
