[
 {
  "id": "UgxucbmwRNsBF7nxCQR4AaABAg",
  "author": "UCOGV2o0UHVaXDj2D1gpgv2g",
  "text": "캠핑에는 물 문제가 제일 중요하지요\n우리나라 방방곡곡 아름답군요\n멋진 캠핑차박정보 감사합니다.",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgyDXD8N_ztjD5ZKdKt4AaABAg",
  "author": "UCE2VGWCAHI-q_YRYb84FyLA",
  "text": "멋진 풍광과 밀려오는 파도소리에  캠핑을 떠나고픈 마음이드네요.   멋진영상  잘 감상하고 갑니다.\n늘 건강하세요.~^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugz8203x3htNv_wGZS54AaABAg",
  "author": "UCd0r7hl-rkhUPIQpigpkTOg",
  "text": "소중한영상 감사합니다 굿굿굿 입니다 자주뵙기를 기원합니다 🙏 🌸",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugz-aq2dGPK_bR0FswJ4AaABAg",
  "author": "UCooKbf4B4Dc2wUx4VfJ4jdw",
  "text": "올만에 고흥소식반갑네요,몇년됬는데!! 라라님감사요",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugwfyfmr3-LrPI_WGDF4AaABAg",
  "author": "UCuQAwba-2XZESNyUaqf2OAg",
  "text": "바다만 봐도 속이 시원합니다 늘 안전운전 하시구요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzSH9gyEmMIcHs2iV14AaABAg",
  "author": "UC-FacreNUkOHyTn4EzCGgSw",
  "text": "감사합니다 고맙습니다 \n최고에요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzJni6osCWykwqLXEV4AaABAg",
  "author": "UClSomyUiok8GmTCBaduAmvA",
  "text": "겨울은 조용한 해수욕장 이지만 여름철은 바글바글 하지요.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw7_n0_bF8qAkgrPYh4AaABAg",
  "author": "UC_YEjjZf6MOdl-T8AKvJrfA",
  "text": "좋은곳, 필요한정보, 좋은영상 잘보고 갑니다.. 감사합니다.. ^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugw3xL6U7bInFyCZ6U94AaABAg",
  "author": "UCKuew3Pzw5UPfHNDakdc3dQ",
  "text": "고흥군  일주를 차박으로 하려합니다 좋은 정보로 잘 다닐거 같아요\n감사합니다:)",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwMu_blkyiuVRCkKLN4AaABAg",
  "author": "UCkuLHcjViNLN57gAdDHed5A",
  "text": "역시 물이 제일 중요하죠...오늘도 행복하세요...^^",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzLpd5_GXiiDngq_KR4AaABAg",
  "author": "UCH1SBsbjaVEdKdfbGkbRfaQ",
  "text": "멋진, 영상 감사합니다 ^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugy-DQyj6ju06JIKZMF4AaABAg",
  "author": "UCFHhsvSlEk2Cd-h5YvPKrww",
  "text": "남해 다 그림이쥬  통영 제승당 들어가보세유",
  "likes": 1,
  "is_creator": false
 },
 {
