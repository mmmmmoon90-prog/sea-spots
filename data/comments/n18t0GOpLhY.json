[
 {
  "id": "UgxPwOtsTx0OyWIooFF4AaABAg",
  "author": "UCuPvWmvznld-gmx5rbOJboA",
  "text": "오늘 처음보고 반해 구독과좋아요로  감사의 마음을 전합니다",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "UgwJ3iUCLitwYWyKW5Z4AaABAg",
  "author": "UCggLPVs6tc1qJsvP6GlbLow",
  "text": "오늘도 멋진 영상과 낚시 포인트 재밌게 즐청하고 갑니다 ㅎㅎ 👍 😄",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "Ugzzl7N88dEh2rawerl4AaABAg",
  "author": "UC6-vlSjqqGwZ_tyID151s-g",
  "text": "화이팅입니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugze8XW9ozBD0QZdxmR4AaABAg",
  "author": "UCemArhdXSVtKBf-58iktPUA",
  "text": "구독후 잘보고있습니다.\n집이 대구라서 포항위주로 보고 있습니다 ^^",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwULxYNBP9qVtLYN2R4AaABAg",
  "author": "UC2-KLsEV-2AF4r0uxjJy8gA",
  "text": "영상도 음악도 멘트도 굿굿~~^^\n그 중 제일인건 훌륭한 낚시 정보네유!\n잘보고 갑니다~~~~👍👍👍",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwKryirPrlR6Lym8YN4AaABAg",
  "author": "UC2XYbaeyL-u4LuSbdLmK-9Q",
  "text": "자상한 설명에 감사드려요. 죽기전에 한번 가볼겁니다.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugzlz37sHJKa8vzbmqh4AaABAg",
  "author": "UCLC9LKhJgUXrk4w7K03gsDw",
  "text": "매일매일을 기다리게될줄은 몰랐습니다...좋은영상 감사드립니다...",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugylnh5x-Jn7GO3lbWd4AaABAg",
  "author": "UCgeyEOz90hm3EOUNC-7u6VA",
  "text": "'나의 쓰레기, 나의 집으로~'에 동참합니다~ \n세세하고 꼼꼼한 포인트 설명 너무 감사합니다~ 오늘도 즐감하고 갑니다~^^",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgzB0NUdJwONys7N6od4AaABAg",
  "author": "UCJV1w2e6NY0Tfham2VzouYA",
  "text": "바낚포투님 고마워요?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxAy96-ofSRu2UHo-d4AaABAg",
  "author": "UCedHVZrjXbiaUoqPSemGj-w",
  "text": "항상 좋은 정보  감사합니다^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwfAKPGnWdbrZM0nBF4AaABAg",
  "author": "UC7DqZB92xlWbnoc8yKV5wrQ",
  "text": "정말 깔끔하게 정리 잘하셨네요. 거제 현지인이라 상당히 자주가는곳입니다.\n거제도 포인트 많이 소개해주세요. 구독 꾸욱 누르고 갑니다.",
  "likes": 8,
  "is_creator": false
 },
 {
  "id": "Ugx1kXfXat5UZIJxRcd4AaABAg",
  "author": "UCEfn_rwy-PoHd8psemlNFGg",
  "text": "영상 잘 보았습니다 감사합니다 💜",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugxe9-KEpyS7qatH7JB4AaABAg",
  "author": "UC3Md86xL9ap58HWFac48CgQ",
  "text": "바낚포설명굿임니다수고많이하셨네요감사건강하세요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgybUkPeavq-Wk2n8qh4AaABAg",
  "author": "UC7W8-N6En-ZcbqCTkecN8vA",
  "text": "멋진 영상, 멋진 설명 \n감사합니다. 👍👍👍",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxE8-oJrfSAmSXOt_l4AaABAg",
  "author": "UCdC5_DcGlg4vi1neZMDT2LA",
  "text": "잘보고감니다.감사합니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugx3pgsm6l6XTyyFsB94AaABAg",
  "author": "UCSU5MsgwN3W0wqF7fg-fMfw",
  "text": "와~엄청 기네요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugy4EJHKkTBsFDYxQfB4AaABAg",
  "author": "UCJdVLWkIRWLpVzELZY90LbQ",
  "text": "안녕하세요? \n정말좋은곳으로 보여집니다.\n서울에 거주한지라 \n소개하신곳은 부러움에 장소이네요~^\n\n퇴직하면 좋은곳을 다녀봐야겠어요.\n감사드립니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwSDIm3Zo9znrHYU7t4AaABAg",
  "author": "UCUXxOH-MLg_BpmRdfENMlGw",
  "text": "영상 잘보고 갑니다 좋은 정보 감사합니다~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzdKfJ6NGC7cJ7tNAt4AaABAg",
  "author": "UCuG4y1eXdPQuF8gtAFi2Lrw",
  "text": "최고네요 영상 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxI0_kr-DwlLMS2b4l4AaABAg",
  "author": "UCMsEK1qSOARShzteAUb7kcA",
  "text": "능포방파제. 거제에서 유명한 방파제 중 ㅎㅎ 하나로 아름다운 능포, 자주 갔지만 20년 8월 지인과 같이 갈치를 50여수 낚은 곳으로 당시 많은 비로 물색이 누렇게 탁했는데 갈치가 밤새도록 나오 던 곳입니다. 정말이지 쓰레기 제발 만들지도 말고 버리지도 말고 남의 쓰레기 까지 가져오면 얼마나 좋을까요? \n저는 고기 못낚아도 뒷 트렁크 가득  남 쓰레기까지  가득 싣고와 집에서 처리 합니다. \n바낚포님 내가 자주 가는 곳 어케 알고 자주 소개해 주니 넘 좋아요. 추천 구독 꾹 눌러 주세요. 바낚포 화이팅!!",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "Ugysc6Rnhckt6lWKj1h4AaABAg",
  "author": "UC_HfMAK2s-UCpkK5tP8LMvw",
  "text": "잘보고갑니다 \n감사합니다 ^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugxqmf-RGm8QMz4HgTR4AaABAg",
  "author": "UCOVR0JXk-fLwhu6esflWmCw",
  "text": "감사합니다. 구독하고 갑니다~^^",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugxqb7CztWytcQ4eq0x4AaABAg",
  "author": "UCMsEK1qSOARShzteAUb7kcA",
  "text": "밤이면 내항 아파트 건물네서 아름다운 빛이  방파제를 5색으로 물들이는 곳 ,지금도 생생하고 참 잊지 못할 곳이죠. 딱히 낚시가 아니더라도 능포 주변 관광하는 것도 추천하고 싶어요.",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "UgzR8jHtjLMyr0LOHqd4AaABAg",
  "author": "UCkTzyIiXmNmgpkSiInDdx8g",
  "text": "영상 잘 보고갑니다~~^!^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxqwvMAC-e808KWk1R4AaABAg",
  "author": "UCn9gI-U7K6MNScXFguzx_8g",
  "text": "👍 👍 👍 👍 👍 👍 👍 👍 👍 👍 👍 👍",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx-72Oj7QqBWf1mTkh4AaABAg",
  "author": "UCA1LdhXrDyXRbsOB4dISrAw",
  "text": "가고싶습니다!!!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz3nx72f4ajELl_Xgd4AaABAg",
  "author": "UClovV4SUm8cfcB_If2qMy6Q",
  "text": "나도\n한달전에가본곳이네",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyCc4glABFThr_O8TJ4AaABAg",
  "author": "UC_zWzpWgOSfzlll80x4gKVQ",
  "text": "감사합니다 구독합니다 세칸하우스찿고있는데 거제로확정할까합니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxhPuSkJkrhoKat1eh4AaABAg",
  "author": "UCpg-4A8sggU2YxI_eWnLLVA",
  "text": "낚시와  쓰레기     그것이   문제    고수 님 은   남이  버린 쓰레기 도 주워갑니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw73XnXFHxw_nVoMkt4AaABAg",
  "author": "UCEWMXvL0o-b3VIJy4Ze68Xw",
  "text": "거가대교 입니다~",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxoRZdVa5EDlxlKIbl4AaABAg",
  "author": "UCGxuTVjJSiVPIpO5_7JAx6Q",
  "text": "가거대교가 아니라\n공식적 명칭은 거가대교입니다. 잘 구분해서 사용하시기 바랍니다.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwXVhbN7KHnOT1TpJp4AaABAg",
  "author": "UCjHmPW3ayxqcHm2hf0onUJw",
  "text": "1:10 거가대교 입니다. ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyqAHqKqcz_H1o7bdV4AaABAg",
  "author": "UCutmbufSzKlxn4WQ4qsiYkQ",
  "text": "이번에 덕분에 능포항으로 가려 합니다.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugx0GlRSk6r7j4suNx54AaABAg",
  "author": "UCgJnLv_ONhqCSPKaAi8fTfw",
  "text": "참감사\n낚시후 쓰레기 제발 \n가져갑시다,\n안내감사해요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzN123sai-VyiENg8N4AaABAg",
  "author": "UCrQDRLQz8x_QzmcIUCzwJCw",
  "text": "방파제에 텐트치고 \n쓰레기 버리고가는 인간들 경멸",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzEh1Qyt7J4XxByai94AaABAg",
  "author": "UCMth86KuBZBBxq_GAM0fE-w",
  "text": "꼭 차 트렁크에 쓰레기를 싫고 가야하나요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy65PzIjYlKIbB9iRF4AaABAg",
  "author": "UCVcVxS672crJGy_ThcSG67w",
  "text": "쓰레기봉투를 가져가지 않는 인간은 쓰레기통으로",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyUOBEQ8d_Sb3EWP954AaABAg",
  "author": "UCK_MFJRmrBlFWwo_tMxPWfA",
  "text": "요즘 텐트 칠수 있나요 ?",
  "likes": 1,
  "is_creator": false
 }
]