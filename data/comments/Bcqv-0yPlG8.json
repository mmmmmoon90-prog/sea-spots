[
 {
  "id": "Ugy6lzTtQJQ35Ibb4Wt4AaABAg",
  "author": "UCfycxqaKp9x1GOBjuf--wMw",
  "text": "상유방파제 큰방파제. 작은방파제 골고루해봣는데 작은방파제보단 큰방파제 외항쪽이 가능성이 컷네요. 말씀대로 작은시알의 감성돔이 드문드문 물더군요. 그리고 수심이 엄청 깊더라는. 캐스팅전에 수심체크 필수요. 그리고 사리물때에 날물시작되면 조류 엄청빠릅니다 참고하세요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxvX5x4ZXbVY033Gq94AaABAg",
  "author": "UCNRRcpQVAnaqPxu8bhZ4FWQ",
  "text": "영상잘봤습니다 구독합니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzWSO19Sp9LXr8Revp4AaABAg",
  "author": "UCkl3MXgUSO_n0qfVnYuhX5A",
  "text": "방파제 꺾이는 부분에 감시가 잘붙죠",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugx0T6oRdHIVNxMA5EB4AaABAg",
  "author": "UCtjUqxnQlvxc3irY4FhWDOQ",
  "text": "유용하다 유용해 초보자들에겐 꼭 필요한채널",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugxegd3MXPh4P8SKXPl4AaABAg",
  "author": "UC2eynC47i4qhIFu166W58QQ",
  "text": "바다닥님 정보감사하며 구독합니다😊",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugx0r7d4Xv1rjcNDxWd4AaABAg",
  "author": "UCxjlyuGu2pJ2NYLm8gbYWeQ",
  "text": "안녕하세요 저는 월래 낚시 유튜브로 2년전에 시작했지만 지금은 낚시 해루질 투망 먹방 골고루하는 채널입니다 가깝다면 소개한 좋은장소에서 강태공이 되고싶네요 영상료 듬뿍 드리고 갑니다😊",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "UgyggkpDUA8E6Uk36qx4AaABAg",
  "author": "UC5wuEIMxldofbw2Lw65uCZQ",
  "text": "목소리가 매력있네요 ~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugzm3xgLfEXBMN0vEqt4AaABAg",
  "author": "UC6dY7RVgp3tf9jV4p8KiJfg",
  "text": "내가 태어난 마을에서 5분거리네용~\n상유마을ㅋ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzDlzm5-Pa_X--9ZOR4AaABAg",
  "author": "UCNYZOfpAIRKuEc7CVbffU5g",
  "text": "포인트 영상 바뀐거 좋아용 ㅎ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxboQpkQlS7Aqww_Fd4AaABAg",
  "author": "UC2XYbaeyL-u4LuSbdLmK-9Q",
  "text": "구독했구요. 너무 감사해요. 죽기전에 동생하고 걍 배낭매고 떠날겁니다. 경택아 준비됐나?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzIJn7K1ONKH5Gj_-14AaABAg",
  "author": "UCeyTssFPsiLdg7YWmA41Bmg",
  "text": "우리 아가씨 설명이 최고 😊",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugxx5YL4YP-Y7ILWbAF4AaABAg",
  "author": "UCjO1iPUsXVs1HSuQkJg0WFQ",
  "text": "이제 물양장 출입못합니다 ㅠㅠ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw_PVB6adrMw470dCB4AaABAg",
  "author": "UCCdzJvQbz_OZr5_YfkdW8bA",
  "text": "물양장 막아놨으요",
  "likes": 0,
  "is_creator": false
 }
]