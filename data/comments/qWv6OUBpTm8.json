[
 {
  "id": "UgyIaz5Wq6ZXykcShql4AaABAg",
  "author": "UCaj2-TDm-Jby4aaWWOKaoPg",
  "text": "깔끔한 편집과 자막 덕분에 좋은 정보 잘 얻어 갑니다. 감사해요!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy1OTILX89VtaOM0d14AaABAg",
  "author": "UCdsDe8lWqeaJHhhHZz5n50Q",
  "text": "좋은 정보 감사 합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzYQkWQ8fVtLj4mVZB4AaABAg",
  "author": "UC7KhuFAk5_iSjWp9UTS7eCg",
  "text": "많은소식에감사해요❤❤❤❤❤",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwqqdhrCscEuXf5XBp4AaABAg",
  "author": "UCqDviqXzoWCzIXqGv1YzY-g",
  "text": "다음주에 여기 가려고 하는데 좋은정보  너무 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz68qfc0tXFYVnD4CR4AaABAg",
  "author": "UCCajeBT9rbtq3D4PGT0qrKw",
  "text": "오늘도 새로운 정보 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwFqjwOG3F9p4gKD4p4AaABAg",
  "author": "UCHUW0Pf5d9E3Pubp_XXzQqg",
  "text": "영상 잘보고 있습니다\n좋은 정보 감사하고   고맙습니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxJUDt07QErpxDa-F14AaABAg",
  "author": "UCB8YGrv3e1nwaDA5yLpf6lQ",
  "text": "정보 감사합니다 ^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwUfC8Z_OK2d8rXIPB4AaABAg",
