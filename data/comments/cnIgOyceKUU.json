[
 {
  "id": "UgxmGqLNSI5JKfRM9PB4AaABAg",
  "author": "UCvqdgVhhClNlzIMHhaww0hA",
  "text": "이곳에서 인생 일몰 타임랩스 영상을 촬영했네요. \n낚시는 시간떼우기  용이었고 \n일몰이 너무 예뻐서 너무 기분이 좋았네요...",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxzLGZd4sNNLXSLWpF4AaABAg",
  "author": "UCoVtffqLi4Ac3kVEjxafPYQ",
  "text": "여긴 공사가완료되도 고기가 정말없어요ㆍㆍ여름되도 고기가없을정도임",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgzXrt0Z4yC2EmSxkYd4AaABAg",
  "author": "UCswi-Jf06P4wzaAbDbHs1Ew",
  "text": "안녕하세요   영상은잘봤습니다\n아마  남당항은   캠핑금지구역입니다\n현수막이  걸려있는거  못보셨나보네요\n   주차문제로   선상낚시시즌 이돌아오면  또  규제합니다  참고하세요",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "UgydIUJmR3oZ4em4LtV4AaABAg",
  "author": "UCbpNqfkK5jNdDb0_8Nh-w2g",
  "text": "캠낚하기 딱이네요. 좋은 영상 감사합니다.^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxXi20oBbtMImo1umZ4AaABAg",
  "author": "UC4p6kWdridwAeTGg6IuJdOQ",
  "text": "고기보기 힘든 남당항ㅜ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwHsmtYBs40aX9e80d4AaABAg",
  "author": "UCzrijdGSVxho0xYqn8tPxHg",
  "text": "감사합니다~~☺️☺️",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugz0VVVYUo4sMPFcUsh4AaABAg",
  "author": "UCVKFXvV3deZCcxYZAjcDKVQ",
  "text": "영상 항상 감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugykvq83d5SPXboJriZ4AaABAg",
  "author": "UCPzugLfZDZg7UcywdwRPQgg",
  "text": "우와 소개해 주셔서감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugwv74jhKhbRBE9Qnpp4AaABAg",
  "author": "UCQxZgonQrGH6rq71b3o-LtQ",
  "text": "좋은 영상 잘보고 구독하고 갑니다-👍",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwcgPVTUZOwbNV2P0d4AaABAg",
  "author": "UCUFPNmKwqNtEZg-VpZ0FBqg",
  "text": "영상 잘 봤습니다 ㅎ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxkRyrjzMXt9GREivB4AaABAg",
  "author": "UCSESQ2eXqNT0TzDpc0hn_hw",
  "text": "장소멋진데   집이부산    다음에꼭한번    감사합니다 ~~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyPg3cc0dHdrM3h-LF4AaABAg",
  "author": "UC3ihiNu1ss-8McUfuafi7lg",
  "text": "제가 사는 곳과 멀지 않은 곳~! 남당항은 생각보다 밑걸림이 있으니, 낚시가시는 조사님들은 염두 해 두시면 좋겠네요 저도 조금만 날이 풀리면 차박 낚시한번 가봐야겠어요 항상 사람들이 붐비는 곳이라 미루고 있었는데 좋은 정보와 영상 항상 감사합니다!!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy8Bnbe1709Zc_PByN4AaABAg",
  "author": "UCDM4TR4f0N9-nMKaVPSuJJw",
  "text": "남당항이네요^^ㅋ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzQWaSAWrbF_aLd8Nd4AaABAg",
  "author": "UCOW1c2C7QZ2KBuhoDCcMJ9Q",
  "text": "우왕~굿~~이런곳은 어떻게 찾으셨데요? 우리나라 곳곳의 캠낚 성지 소개에 감사드립니다!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyI24-10i1VHSFCnXR4AaABAg",
  "author": "UCLQSvQpwp8vM3UjGVQ2Am7w",
  "text": "와, 낚시하기 좋아보여요.....",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxrFKDjFIcs1Dg8Wu54AaABAg",
  "author": "UC7drg_RkR14PWKzb2XQESFw",
  "text": "편하면 고기없다?? ㅎㅎ\n캠핑위주죠...패스",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyHhFYk85s8zVqIVX94AaABAg",
  "author": "UCN5_Y0giKRzufDv-821NOSA",
  "text": "1박2일로 딱 좋은장소 같네요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwsMpOwGdc78skYYih4AaABAg",
  "author": "UCea5sBKZ_7EV2PAXVYjbK0Q",
  "text": "해루질만 하다가 낚시 영상 시청하니 너무나도 재미있고 좋네요 바다는 항상 행복을 주는것 같네요 선물2종 누르고 갑니다 앞으로 좋은 영상 부탁드립니다 ^^\n10만100만 유투브 되실때까지 음원합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugzy7q2NXVew19Yqb1V4AaABAg",
  "author": "UCQSKqvNAUAZ8BL-reHabQ9w",
  "text": "고기는 없어요ㅋ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwtDTwdLQV7JtAm9oh4AaABAg",
  "author": "UCX6VpClm34nq2a7sjsk-0Kw",
  "text": "남당항 새조개샤브샤브 먹으러 갔다가 엄청 실망했던 곳인데요. 나들이 겸 힐링 낚시 하러 가기는 괜찮아 보이네요. 항구 식당은 거르시는걸 추천합니다. ㅎㅎ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugy18iy6IWjW8Qo8z3h4AaABAg",
  "author": "UCTDcwq5PS9oRxGWAI7Gg6_A",
  "text": "곳 벚꽃시즌인데 벚꽃구경과 낚시를 동시에 할수있는 곳이 있나 궁금해요!!",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwU-EquUarrFwsRpbd4AaABAg",
  "author": "UCq5FE6m5bj0erAlizN1qoGA",
  "text": "캠낚님 드론 날리시는거 같은데 혹시 드론 드랍장치 이용해서 원투낚시 해보실 생각은 없으신가요??",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzOJdx3jWoUUXyYpW14AaABAg",
  "author": "UC8v5MQFh4tYdGSB5sy0sZVA",
  "text": "루어,찌낚시는 답없고 원투 100m이상 던질자신있으면 가보시길",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw4vQiHXRy6lNBX7_d4AaABAg",
  "author": "UCkrichKaQErkJEceGNy9Ogg",
  "text": "밑걸림지옥입니다 원투가시는분들 참고하세요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugxt_S7zlnQkl2GSjB54AaABAg",
  "author": "UCoVVimYKjhKtqh661nLS-LA",
  "text": "금요일부터 밤샘낚시하고있는데 현지분이 가을에 망둥어나오는게 끝이라고 헛짓하지말라함...",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugyo83X-zG7RpuXd6OR4AaABAg",
  "author": "UC3NWPAlJCV5Xr166FSmXewQ",
  "text": "낚시하기 편하면 뭐해? 고기가없는데~~~?",
  "likes": 12,
  "is_creator": false
 },
 {
  "id": "Ugy25nGffy9gnlYBMFp4AaABAg",
  "author": "UCjIStVr2NGemYR9AosSczjg",
  "text": "낚시,캠핑좋은 정보감사합니다. 경치 좋네요.바다근처 염분으로인한 자동차번호판쪽,봉인녹발생 합니다.예방할수있는 봉인구어셈블리 추천드립니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxNZTlxwhFnRMCcraR4AaABAg",
  "author": "UCTaiFYEwsGJgKrcCmE7xH-Q",
  "text": "밑걸림지옥입니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyO0ya2wEdOK5BldT54AaABAg",
  "author": "UCeAvlcTXqR6H7eTtk0pJmgw",
  "text": "저런곳은 고기없음.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzeMT4UGBUPtY7aG9N4AaABAg",
  "author": "UCal2mJ0ecTLhZcIu3EjoZIg",
  "text": "여기 가지마세요 자리싸움하는거보고 캠핑접을까 생각도했습니다 고기도 안나오고 뭔가 잘해놓긴했는데 배타시는분들 4가지없게 말씀하십니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugx2xrctrgwan_wSH254AaABAg",
  "author": "UCD3rrBqv8DrfXkwjIch7yiA",
  "text": "어디가나 쓰레기 행락객들도 그렇지만 낚시인도 많이버리곤 하죠 정말 한심한풍경입니다 자리좋고 주차장에 화장실 ....남은 쓰레기 집으로.. 분리 작업이 최곱니다.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugzq7qfJpM8LNgUCcTt4AaABAg",
  "author": "UC487c6KMiR5QK-gm9X616mg",
  "text": "위에 분 소액으로라도 해봐여 저 300정도 가지고 코인선물하고있습니다 오 픈챗 팅에 코잘남 타점 따라가는데 지금 2000정도 되네요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxyTNlcO5WcTxbmZhB4AaABAg",
  "author": "UCOvLOwePZHe5j2R-x50tm0A",
  "text": "제 주변에 코인 하는 사람있는데 코이ㄴ선물거래로 몇십억 벌었더라구요.,.. 저도 코인 해야하나 싶네요 ....",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw9OPf6ljAETFUEvBN4AaABAg",
