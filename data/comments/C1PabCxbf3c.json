[
 {
  "id": "Ugy4ToeHjbKLn5flDD94AaABAg",
  "author": "UCYhJcg4BcEXd3hckQ1yQzbQ",
  "text": "전국 무료 캠핑차박 300곳 영상지도 https://youtu.be/mQMCYrm8fa8",
  "likes": 3,
  "is_creator": true
 },
 {
  "id": "UgzQdRZyhdTwh2ouHIJ4AaABAg",
  "author": "UCelgCCqj1JgokDIImV1Q6CA",
  "text": "마음은 강원도에 있습니다\n봉길 밑걸림에 바다보고\n멍 때리다 오네요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxFzQ5IWM82gxaBUEt4AaABAg",
  "author": "UCtpt3AjnNQaypPqn8BUBQPg",
  "text": "거진해변은 동계엔 화장실 사용 안되더라구요",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugx3XPIjorMQEC_aUL54AaABAg",
  "author": "UCkuLHcjViNLN57gAdDHed5A",
  "text": "멋진 영상 잘 봤습니다...편안한 저녁 되세요^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgztqRhRAl_9V1KRAUl4AaABAg",
  "author": "UCXr3Eh2L01SLwggJg59ro4Q",
  "text": "강원도 차박갔다가 어제 돌아왔는데 미리 이 영상 시청했으면 더욱 좋았겠어요~ 알차고 좋은정보 감사합니다. 다음 차박갈때 참고해야겠어요 ~ ㅎ 구독 좋아요 꾸욱 누르고 가용 ♡",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugy2y5_ajYfE7TFvSG14AaABAg",
  "author": "UCc6kPYo4dE87gHHJ7LaUcDA",
  "text": "강원도는 항상 너무 좋아 보이네요 위쪽에 계시는분이 좀 부러운데요 ㅎ  동해안 따라 일박씩 하고 내려요면 여름이 그냥 지나가겠어요~  자주 뵐께요~",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugy5Hv-pzgn5Hhj0yid4AaABAg",
  "author": "UCE8u09LpV90UnUh0IUoqevA",
  "text": "가볼만한곳 멋진곳 정보감사합니다,",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwlGeEBM7YxGmt9wEh4AaABAg",
  "author": "UC-N-A9f2Zh6hMKurce7xxjg",
  "text": "감사합니다.",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgwwRS_VCw85QKMvDEx4AaABAg",
  "author": "UClSomyUiok8GmTCBaduAmvA",
  "text": "멋진곳 잘받습니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugw4wizE82_9r85J1qV4AaABAg",
  "author": "UCZ9hI06pcGQq9thocys9Tag",
  "text": "처음 차박지 찾을려니 고민이 많았는데  좋은 박지 정보가 요기 다있네요  감사합니다 ..ㅎㅎ",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugxz4QIrE1P9d20Fwrd4AaABAg",
  "author": "UCe-3Iq7-xcxPEXlWOP1ynJw",
  "text": "감사합니다",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgwOU1sPvDFpLQWlp3J4AaABAg",
  "author": "UCBHeChqD-hoLl-7o9nogP1A",
  "text": "감사를드립니다\n초보한테 큰 힘이되네요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugx1U1vY5nlInUyGSvx4AaABAg",
  "author": "UCQXBiNedKND8ddYHI0ZkzXA",
  "text": "좋은정보를 한곳에 요약해 놓으 셨네요 영상도 설명도 참 유익하고 좋습니다 ㅎㅎ 제가 자주가는 곳은 강릉 안목해변 옆에 있는 남항진 해변 인데 빠진듯 싶네요 해변 송림 피칭도 가능하고 넓은 주차장 차박과 화장실도 두개나 있어 좋은곳인데 혹시나 정보 공유 합니다 ~^^",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgzIaCj2v2vgcYg75xh4AaABAg",
  "author": "UCGZG8Mm4ECRy4v0iblTLiYg",
  "text": "감사합니다 선생님",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyQCTrAP0aRe6-0uLB4AaABAg",
  "author": "UCipZQXuak1bNGv9GO-PdX0A",
  "text": "좋은 정보 넘 감사해요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyXlafllRco52KCxpF4AaABAg",
  "author": "UCD1qarX0X4psdYLYd2wLfFQ",
  "text": "많이 도움이 됐어요. 감사합니다.❤",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugx5Y7Zoz3zJdrccAVx4AaABAg",
  "author": "UCKBSx6A98yiul6znzNUulhA",
  "text": "죽변해변만 가보았는데 좋은정보 감사 합니다~",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzMF4Vc5Sv8TTL1WPd4AaABAg",
  "author": "UC1tfyc1-ydR_il5f5i6oRcQ",
  "text": "감사합니다~",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgytWFgthyWsmuiyDlR4AaABAg",
  "author": "UCzNoCV_B7K70K3-XuudOVag",
  "text": "많은 도움을 받습니다^^구독 꾸욱",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugxbts9LVh5NbJUGY1x4AaABAg",
  "author": "UCOxTAXNR9cIXlVFgeMOxmWg",
  "text": "다~ 가볼려면 한달은 넉넉히 일정을 잡고 가야겠어요ㅎㅎ\n지금은 일단 열힘히 일하고 돈벌고~ 나중에 꼭 가야지요ㅋ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwshLugNxsL1Kcn-Pt4AaABAg",
  "author": "UCx8_puljF2wxAMmMAv3i-yA",
  "text": "송전해변",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzqrsRebZrwC5HtKrF4AaABAg",
  "author": "UCihl8aNZ_IpffNEgMYKszbg",
  "text": "와우  잘봤습니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgykJ_HIXGXvbIaQXTR4AaABAg",
  "author": "UC-9-S1MCXpxm3RJIi1Buyyw",
  "text": "초보 카라반 유저가 가기에는 어디가 가장 적합할까요?",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugy9Gq4ET_laMEB_wRN4AaABAg",
  "author": "UCQEx9-cSkwiYTSwvr_xONkA",
  "text": "선물세트 드리고 갑니다.👍👍👍👍👍👍",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzYpK5CPn0sAHWOpJp4AaABAg",
  "author": "UCd9Qt97jdNskrg3DWbdCsNg",
  "text": "핫플 재미있었겠어",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugzv_f50ITMb0vabX694AaABAg",
  "author": "UCnJ5TSUqkcX02Jf4z52JrgQ",
  "text": "똑똑...^^\n선생님, 저도 일하느라 다녀본 곳이 없어서요. \n꼬마들 댈꼬 서울에서 갈 만한. 바닷가+화장실+팩박을 수 있는. 무료 차박 할 수 있는곳 찾아요. 한 두군데 알려 주시면\n용기내서 가보려고 합니다. 갈만한 곳 있을까요?",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwLsZseEuR75RAlcwh4AaABAg",
  "author": "UCmutv9e_delTkm_PHd3EOkw",
  "text": "좋은정보 감사합니다~~^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzY9N4Vtcv-v0LlWXt4AaABAg",
  "author": "UCmvkBYYwsmK0-YMU2Vs8JPw",
  "text": "좋은정보~~항상~~늘~감사합니다~~\n저도 다음주 출발하는데  넘~감사합니다~",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxvJ2EUp5vJkhcTLGh4AaABAg",
  "author": "UCEfn_rwy-PoHd8psemlNFGg",
  "text": "잘보고 잇어용ㅋㅋ고생많으셨어요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzRB9JoCKqSQjrI7oB4AaABAg",
  "author": "UCJQBwyYp2t95f-u7DhL2NLQ",
  "text": "잘보고갑니다 꾸벅",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxSrElrjCTHWLG0-4R4AaABAg",
  "author": "UC-646erYzaw8DMmjbCJE7Aw",
  "text": "성수기에는 막힌곳이 많아요 ㅠ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyxSoXUT4TB03VtlCZ4AaABAg",
  "author": "UCEOzmF8roiFPFOPc09dggvw",
  "text": "수고 많으셨습니다 ᆢ\n감사합니다 ᆢ\n캠핑 텐트 와.차를 승용차 를 이용해서 .많이 다녔는데. \n모르는 곳 이 많읍니다.\n동해 해변 솔밭 텐트칠 곳을 아시면 알려 주세요. 무료인 곳이나 싼곳을 아시는지오ᆢ?ㆍ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugz8mzXmaVyCtDWOejZ4AaABAg",
  "author": "UCAhVAAbraY5qt7LEmVLx8ag",
  "text": "오늘 어디로가야하나 계속고민중였는데요 거진항을 결정을했다가 후진항도괜찮은거같네요 캠낚이라 오늘은 고성거진항갔다가 다음날 후진항으르가봐야겠네요 장소결정에많이도움되었네요 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx5RQnpKjTDa8RCcAp4AaABAg",
  "author": "UCie2bM8lSFQlkFaKD_jf9Ew",
  "text": "라라님의 부부캠핑하는 모습을 보니 보기좋네요 그리고 알찬점보 감사합니다 그런데 궁금한게 있는데 \n라라님의 캠핑카가  어떤 종류의  캠핑카 인가요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxnMXLxMAGJ1LUMJ6d4AaABAg",
  "author": "UCe1W4MgThA-MFcsRRuVcLtg",
  "text": "저는 항상 유료캠핑장만 가봤는데\n노지차박 장소도: 전기나 취식 가능한가요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwpiNlGaNeQIdvQ9yd4AaABAg",
  "author": "UCeMrMbuxmPDrwqyeIRBimkw",
  "text": "낙산항 차박금지 구역인대요;;현수막도 붙어잇어요~~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzdSMHozf4G58wrAwh4AaABAg",
  "author": "UC5PuCKKRFEBFD4uKpnMrnMA",
  "text": "강릉최고의 차박지는 금진해변임",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwKDLWEfExvbMeRvgF4AaABAg",
  "author": "UC6CugJj6KCVVpkXB6ybz_XQ",
  "text": "충전 시설 필요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxTOuRVlv5BsuoKGW54AaABAg",
  "author": "UCpDnXApifJF9E7JyAR9MZvw",
  "text": "차박장소를 좀더 정확하게 정보 주시면 구독자가 늘것 같아요. 너무 쓸데 없는\n내용이 많고 정보가 부정확하니까\n무료 차박지를 찾는분께 허위로\n판단되어 조회수가 않나오는듯 합니다.\n지적한다고 생각하지 마시고 한번더\n생각해 주시면 감사하겠습니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgygPsW_D3TSjR6iS2R4AaABAg",
  "author": "UCiLWu0VnSi9mFz4PfCn9Zrw",
  "text": "차박은 화장실이 제일 큰 문제인듯",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzGyvGVoLJvp5Apjyx4AaABAg",
  "author": "UCCgZM22xzqJpHX4IEqIwglQ",
  "text": "구독추가^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyW33MSO_rcDTIkWMF4AaABAg",
  "author": "UCsYlnIABiPMZbJG1NW--JyQ",
  "text": "잘다녀오셨슈 그러치안아도 출발하려고 했는데  고맙슴니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugzn7XYru2bPw1KCQ-h4AaABAg",
  "author": "UChtR4jgrVqhfmoBoydJ2UOg",
  "text": "어째서인지 가아니고 쓰레기와 캠핑카 알박기가 가장 큰문제니깐요.제발 ㅆ.레기좀 가져사자",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugz0kRdotoWYQN8uY414AaABAg",
  "author": "UChrIrymNq1WScN-VLxwjoUA",
  "text": "다음주 연휴때 드디어 첫 동해차박예정인데 ㅎㅎ 완전 도움되는 영상이네요 ㅎㅎ 7번국도따라 쭉 가보겠습니다 ㅎㅎ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzKwp2TmKNEB15Jq0V4AaABAg",
  "author": "UCDkkStd4JjeU9X2ixDxmd4A",
  "text": "좋네요~^^!!\n제가 즐겨가는곳도 여름성수기땐 유료화되더라구용\n무료일때 자주가야하는데~^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyaGlwZxf60_mg_jDx4AaABAg",
  "author": "UCZZ59h-wAROk3Ib3tRD1plw",
  "text": "지역주민 위해서 최소한 유료화 해야 합니다.\n이른 아침 모래사장에서 쓰레기 발굴하시는 모습에 아침 운동 나갔다 얼굴이 찡그려졌어요.\n주차비와 숙박비는 내시는 차박문화",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyfsISD_pYkZDEiOMd4AaABAg",
  "author": "UCwYytpE3Wm6RDp4uiY5UBcg",
  "text": "좋은정보 감사합니다",
  "likes": 2,
  "is_creator": false
 }
]