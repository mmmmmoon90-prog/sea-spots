[
 {
  "id": "UgyD_hGibZoI4P0R2EN4AaABAg",
  "author": "UCrOmkhlnaQ8g9ifJE8ujhWQ",
  "text": "제발 이런곳 막히지 않게 클린캠핑들 하셨으면 좋겠습니다.\n멋진 송림노지 입니다^^",
  "likes": 7,
  "is_creator": false
 },
 {
  "id": "Ugz-VV-jive6lHQI63t4AaABAg",
  "author": "UC_IH6xJ61PtQ_Em_-iTdB6A",
  "text": "정보감사해요 \n제가 난시가 있어서그런가요 \n카메라 이동이 좀빠른거 같아용 슬쩍 어지럼이 왔어요 ㅋ \n즐거운 주말 보내세요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgytwLQVQUmj_06G66d4AaABAg",
  "author": "UCkKrR07nyWcl3MTWnXL5nQQ",
  "text": "오늘도 바쁘게 인생을 즐기고 있네요   항상 행복하고 여유로워 보여서 좋아요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxmGE5YDuuOD7WLBAt4AaABAg",
  "author": "UCJDJKb_oEowUSO5IcPBz0FA",
  "text": "좋은곳 눈으로도 호강합니다\n나중에 시간되는날 다녀봐야겠네요\n좋은곳 소개 감사드립니다 ~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw7NgBN9jt7NVTz4_p4AaABAg",
  "author": "UChrIrymNq1WScN-VLxwjoUA",
  "text": "오~~오늘은 전반부에 브금과 함께 했네요 ㅎㅎ \n전 브금보다 호이쭈리님 목소리가 더 듣고픈 ㅎㅎ \n요기도 참 좋군요 ㅎㅎㅎ  이번주 보령쪽 차박가는데 ㅎ 혹시 자리없음 요기로 가봐야겠군요 ㅎ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugze2H39N3x8uh-3fWd4AaABAg",
  "author": "UCxobapNwEuoWRsYgzqrdsew",
  "text": "와..뷰좋은곤은 다 머네요😂😂 휴가때 가보고싶어요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxXlzKpQ5v7pPjmL2p4AaABAg",
  "author": "UCOwys3c3eKvXuE8klpc2Qvw",
  "text": "지난주 5박하고\n왔어요 비소식이있어서\n그런지 몇팀없어서\n조용하게 있다왔네요 중간에있는\n화장실은 내부수리를 하고\n있어서 입구에있는\n관리실건물화장실 이용하셔야되요\n입구조금들어오면\n분리수거 함이있는데 분리수거좀 잘해주시면 좋을텐데 아직도\n안지키시는분들이\n계셔서 좀그러네요\n중간중간 음식물\n수거통도 있어요\n캠퍼님들 클린캠핑\n꼭 부탁합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyBOsEUzpfrDnwD1-d4AaABAg",
  "author": "UCFHhsvSlEk2Cd-h5YvPKrww",
  "text": "좋은곳 항상소개해주심 무안해서  전라도영광입니다요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugyabagr0jqfjZLv_Kd4AaABAg",
  "author": "UCMyOg-36eTPnwGZTdJa5kOw",
  "text": "*항상 좋은정보 주시는 호캠님*",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwQLVNDca67ThX_8Sh4AaABAg",
  "author": "UCuFjeY7c-ek9izioo06qXYQ",
  "text": "몬테라 bbq의자 인가요? 저도 경량의자 조립하기 귀찮아서 플랫체어에 bbq의자 사용하고 있어요 ㅎㅎ 편하지만 부피가 크다는 단점이 \n날 더워지니 간편하고 차를 옆에두고 바로 내릴수 있는곳들만 찾게되네요 ㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyGEBxNZwcqNpLdLCl4AaABAg",
  "author": "UC_URJ5MWs0wxCAXxNwjE8tA",
  "text": "무안군에 이런곳이... 감사합니다^^",
  "likes": 0,
