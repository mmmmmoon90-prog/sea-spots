[
 {
  "id": "Ugw-7rD8rsUtMCf8S9B4AaABAg",
  "author": "UCGsBHKktKzr0Gd7ZhH-smpg",
  "text": "영상 감사합니다~건강하세요!^^",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyVAbnobQ0uPKLwQbt4AaABAg",
  "author": "UCaQXiGWGKObWUtdrBBxEvRA",
  "text": "함게하는 모습이 보기 좋아요~~^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxPXww-zy_YV8HQ6oh4AaABAg",
  "author": "UCFRBuNFU4K-0yO3KxyqsKmw",
  "text": "너무 멋진 곳이네요 ~ㅎㅎ \n예약하기 힘들겠네요😂😂😂\n덕분에 대리만족입니다~😊😊😊",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwO26kNCsgI7eJ16Sp4AaABAg",
  "author": "UCcLLiXTc9iYkEOLtuW4wb0w",
  "text": "좋아요 👍 \n누르고 시청 합니다 \n고맙습니다 🎉",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwyhoV1piabJQ5V3DV4AaABAg",
  "author": "UCgh_O7C7NazDecAq64v0mig",
  "text": "저도 2박3일 잘 다녀온 곳입니다.\n가는길 해변도로도 이쁘고\n하루종일 바다파도소리들리고\n시설도 나쁘지 않았습니다\n근처에 편의점도 있고, 해변도있고\n\n또 가고싶은곳이네요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugwnrm9xEgYHfUVCkE14AaABAg",
  "author": "UCEHC3fVFGN6kWJcM-OK05Gw",
  "text": "지자체에서 운영한다니 저렴할 줄 알았는데 일반 캠핑장과 거의 비슷하네요 ㅎㅎ",
  "likes": 11,
  "is_creator": false
 },
 {
  "id": "UgzD7sWT8FQ6XvKhMA54AaABAg",
  "author": "UClfLUc83qSsfxQDkg-xyqvQ",
  "text": "다 좋은데 저놈의 난간땜에 바다뷰를 가리니 아쉽네 ㅎ\n항상 영상 잘 보고 있습니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwdY-hwY7XgGY60MTJ4AaABAg",
  "author": "UCd8wkzAB78WdnYAisZg9_Kg",
  "text": "강릉 바다내음 캠핑장 소개 감사합니다. 경치가 좋네요. 정동진도 가깝고. 관심을 갖고 보다가 요금을 보니, 강릉시 운영인데 가격이 너무 비싸요. 강릉시에서 운영하는 연곡솔향기 캠핑장이 훨씬 저렴합니다. 넓고, 시설도 좋고.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxLPm8M6HlMFTxxVUd4AaABAg",
  "author": "UCFHhsvSlEk2Cd-h5YvPKrww",
  "text": "대전에서 왕복4시간 강릉이상 윗동네가셨나봐요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw4h7iV3q8rHiMRiGp4AaABAg",
  "author": "UC-PXjwp8ZhhNWJ2NWZQaTpw",
  "text": "바다 내음이네요. 애견동반 안되서 포기했지만 가까운곳에 하슬라아트월드 가볼만 합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzhElXeJmBog62B6DN4AaABAg",
  "author": "UCFDO0PLbK9kb-yQPIH3-oBA",
  "text": "낚시는 안되나요?\n영상감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyFCb9qBX8aSwNCqht4AaABAg",
  "author": "UC3qwAbjOSAREjiAjeRDaIZQ",
  "text": "4~5만원 지불하고갈수있는캠핑장은많이있습니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwK6UU-HHnlh1NO3d14AaABAg",
  "author": "UCbLehXT6ISBnNAa3qsBxqcQ",
  "text": "참~나    가격이     ?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx3-_ZSRY_prcyiDY54AaABAg",
  "author": "UCk9vSoamDiJTNOkuCVArf7w",
  "text": "주말엔 아주 난민촌..앞뒤로사람들이 오가고..",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyldEBz7L6EMouRV1x4AaABAg",
  "author": "UCKO5rArUYBVyEnQFrgDbvzA",
  "text": "지자체 운영이라면서\n가격이  사설 수준으로 도적늠이네 \n싼차박이 아니구먼 ㅋㅋㅋ.\n지자체 운영은 무료이거나  2마넌대도 많은데\n저런 데는 가주면 안 될 듯.",
  "likes": 13,
  "is_creator": false
 },
 {
  "id": "UgwEQDx7qYQm_lrmoAB4AaABAg",
  "author": "UC3k7TH1FEPusMWTFsWC7-NA",
  "text": "비싸긴하네요 ㅎ  해루질같은것도 같이할수있는곳인가요?? 테트라포트보이길래 여쭙습니다.",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgyF3BiAPdo8oybtzvR4AaABAg",
  "author": "UCxXbnBd_8pYOQW1aRrfWK4g",
  "text": "망상오토캠핑장 추천 합니다.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxWUH2E_jwJua1LmUV4AaABAg",
  "author": "UCQQ9wNMATozYxgVKeqSYzNQ",
  "text": "평일 40000??  지자체 갑질 수준아닌가여?   조식이라도 주시나??",
  "likes": 6,
  "is_creator": false
 },
 {
  "id": "Ugz5RXHn27qll9fM5wh4AaABAg",
  "author": "UChM-X5VFpSG2P08q1n9ChlQ",
  "text": "동해바다에 널린게 노지인데 굳이 ㅎ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwUk37eqAebqUBZDWl4AaABAg",
  "author": "UCIc2hPY-b1xEaOkuc35ZOUw",
  "text": "지지체라고 가격도 일반수준",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugyl9EmqlWtXJXzIJ4Z4AaABAg",
  "author": "UCRevei5qQtJKipamAb5X_BQ",
  "text": "어디인가요?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyoccCwHhob-w_VPNR4AaABAg",
  "author": "UCDHrFBE3QQPC9zDGsBQ3ZWQ",
  "text": "가신곳 정보좀 부탁드립니다",
  "likes": 0,
  "is_creator": false
 }
