[
 {
  "id": "Ugwpdxv-4NWdnzPaINt4AaABAg",
  "author": "UCGLP8Zyewo88pNPotQI89zw",
  "text": "심리방파제는 죽은지 오래됐어요 ㅋ",
  "likes": 9,
  "is_creator": false
 },
 {
  "id": "UgwryTHJ3_cgd4xp31J4AaABAg",
  "author": "UCMV-Jqphly6tX9XYgZWe7Rg",
  "text": "마산권으로 와서 반갑네요!\n좋은 설명 감사합니다 ❤",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz-a11yltlVLprzLPR4AaABAg",
  "author": "UCUebzHeFkR9G3eJZvxWzGDQ",
  "text": "어랏!!!  구산면이네요~  다른 명당이 많으니 더 좋은 영상 기대할께요^^",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzPvYbt8vDNhlCT-V14AaABAg",
  "author": "UCfMapdbCR_9FMxfqxhjjCrA",
  "text": "저는 동해권인데 경남권 마산도 많이 좋아 보이네요  \n한번 꼭 가보고 싶네요  포인트 정보감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxNdfIaddIW1LgQpDh4AaABAg",
  "author": "UCvFhUNP_Le428xc2Npo4BoA",
  "text": "바다닥님 얼굴 나오는 영상은 없나요? ㅋ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwRM7DJMlw8EaAY17t4AaABAg",
  "author": "UCZkc6XruvAVXew07R7ekXgw",
  "text": "안녕하세요~항상 영상 잘보고 덕분에 참고 많이하고있습니다! 혹시 최근영상들 중 인트로 첫번째에 나오는 포인트는 어디일까요ㅠㅠ이제 가을이라 남자친구랑 같이 캠낚 가려는데 너무 좋아보이네요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyCiVJU-omGl0zexq94AaABAg",
  "author": "UCUyx0dEXydA0Lyt__srdQ1g",
  "text": "심리 고기 없어요 낚시하면 꽝쳐요  걍 놀다가는정돈 괜찮음요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxqIcTHgds0ysVG0WZ4AaABAg",
  "author": "UC_CSCiRGIyRsTBaDsmZNaKA",
  "text": "한적하니 좋네요~ 잘보고갑니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxIEwz60ozxFZCLEsp4AaABAg",
  "author": "UChkJMnezKsnRpNjepzlE-ZQ",
  "text": "거 고기없어유~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw6HczGdHz8fKUz4c14AaABAg",
  "author": "UChcUBU4XInOdPQXN2_D2XUQ",
  "text": "부담없이 가도\n평타치기 좋은곳이죠",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgydyPTN7Z8f451ofM54AaABAg",
  "author": "UCYRK7cbVJO9nrg4xPO9UUlA",
  "text": "❤",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwUgX5HLH1Xfl2STEB4AaABAg",
  "author": "UC95nhjimKHG406VWlC1q0rA",
  "text": "아무것도 없음",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgybS50jXc027qlD2iZ4AaABAg",
  "author": "UCfSlxVbBk3pup3JQ0EMQcBg",
  "text": "화장실만 있음 딱인데 아쉽",
  "likes": 0,
  "is_creator": false
 },
 {
