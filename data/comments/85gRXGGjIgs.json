[
 {
  "id": "UgwEHHEQKalaeOUAoBp4AaABAg",
  "author": "UCiMbM1TokwvS63faCNOs6rA",
  "text": "바람 부는 날에도 비교적 바람도 덜불고 좋은 포인트지요~ 조만간 또 가봐야겠네요 소개 감사합니다!",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "UgwOkfeJuOSlo-otOvl4AaABAg",
  "author": "UCxjlyuGu2pJ2NYLm8gbYWeQ",
  "text": "알람떠서 빠르게 후다닥 뛰어왔어요 지금부터 즐청할께요 😊",
  "likes": 3,
  "is_creator": false
 },
 {
