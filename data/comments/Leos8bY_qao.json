[
 {
  "id": "UgwhnTxCF4U8R3bnmvR4AaABAg",
  "author": "UCdmGPXXfVTicCIsLNy0mkpw",
  "text": "제주도로 차량을 가지고 오실분들은 참고하세요\n선박회사마다 차이가 있지만 대략적인 시간은 이렇습니다 ^^\n \n완도 - 제주 : 약 1시간30분\n고흥 - 제주 : 약 3시간30분\n목포 - 제주 : 약 4시간\n부산 - 제주 : 약 12시간",
  "likes": 12,
  "is_creator": true
 },
 {
  "id": "UgzGxOx3AUUzXUxEwDd4AaABAg",
  "author": "UCw1I_NZ9AwRRevuio2XKCog",
  "text": "일년 전 영상이긴 하지만.. 여튼 추가적으로 꼭 아셔야 하는게, \n비성수기 때 무료 오픈이지만, 전기, 근처 화장실, 계수대 모두 닫혀 있습니다.. \n즉 샤워실 없고, 화장실 멀고, 식기 설거지 할 곳 없습니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxyfyWr9cXo4EYrAZx4AaABAg",
  "author": "UCFQfSKpcWBc1b4z4M7iNuHw",
  "text": "와~~~~ 문어 \n전 문어 몇주동안 구경도 못했네요 ㅠㅠ\n영상 잘보고 갑니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugx32vfKO6knnBpk5Bx4AaABAg",
  "author": "UCB9LQJ7ieCD8ZLzWXENxr9w",
  "text": "10월인데 유료로 이용하고 갔다왔습니다 바꼈나봐요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyfdYjc9vrXduzs79d4AaABAg",
  "author": "UCTyxMKlkA2_JHyfxlZo8b2A",
  "text": "정보 감사합니다👍",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyrvHx2AzOkScNqmb14AaABAg",
  "author": "UCELtrOgq5gpZr2LJxQcKfFA",
  "text": "끝내주네요가 아니라 완전 환상입니다\n좋아요 꾹",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzNnL8QPS4yNLtUfgV4AaABAg",
  "author": "UCOPmV2QIUIHvsHApcZV8U_A",
  "text": "정보를  제대로 자세히 말해주시네요  감사합니다\n\n좋아요  구독 부탁드립니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwLBlJfdXRsbFuHQDx4AaABAg",
  "author": "UCoP4QNI17NfhVtaVGJ7wiLw",
  "text": "바다색이 주변과 잘어울리게 이쁘네요...역시 제주도...",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwKuInS8lB0-FG8VNd4AaABAg",
  "author": "UCighF4kGBK8oGM6jRJ0U4xQ",
  "text": "좋아요~즐거운 여행하고~귀가 하세요^^감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyOOr9SFpEobJ_Noi54AaABAg",
  "author": "UCSMvD3tMLrMVFXBmWd4oWRQ",
  "text": "제주도 진짜 요즘 마니들 가시군용🚙🚙\n안그래도 차얹어가 제주도여행 한번 계획중인데\nㅎㅎㅎ 참고하겠숩니드아 :3 💚💙",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxcKimbe1K1a0X1JJ14AaABAg",
  "author": "UCrYsmK6WPyLNM_4qjNKgYfg",
  "text": "와.....역시 제주도 너무 풍경도 빨리 제주로 차타고 떠나고 싶어져요!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz073CrGH9GuL-9qUV4AaABAg",
  "author": "UCpTzFck_zYCbKRHi9DsCcBg",
  "text": "좋은 곳 소개해 주셔서 감사합니다~~^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxuVLRC-DbeY13Ej-B4AaABAg",
  "author": "UCeV6wtwZVG1JlcgBciWoaLA",
  "text": "와~ 위에서 둘러보니 정말 아름답네요..ㅠ.ㅠ 가고 싶네요. 제주도.......지정석이 아니라서 경쟁이 치열하겠네요 ㅋㅋ 정보 감사합니다~!",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwQscd6wsHGrl8SqNd4AaABAg",
  "author": "UCTm8pXWpAV1lrWSQAxEyB7g",
  "text": "제주도는 모든곳이 포인트네요.\n제주도 함 가보고싶네요~^^\n좋은곳 영상 잘보고갑니다~^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyOY4x8LJsZs0F-UR94AaABAg",
  "author": "UCDyFUDr25UkEMXGQcIj8e_Q",
  "text": "벵에에 혹했는데 제주도네요ㅠㅠ\n좋은정보 감사합니다👍",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz0GckAUhJCICtwAXF4AaABAg",
  "author": "UC_UP_ceXOmLvQmv0KEwoAlA",
  "text": "제주도 캠 가야겟네요 ..좋은정보 감사합니다 .",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugxp29tVv1gDMV-GVid4AaABAg",
  "author": "UCKrdC6Ra90BAx3M032ILnsg",
  "text": "오늘은 다보고 댓글다네요...ㅎ 제주 좋지요 가고싶습니다~~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxIB1WuEk9Y7qUzv-V4AaABAg",
  "author": "UCZjxZutXAVmQM97Nf7DjlVw",
  "text": "다음주 제주 부모님댁 가는데..한번 가보겠습니다..^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzcRK8cM2EjSeHKDht4AaABAg",
  "author": "UC8ZkUMdugJOjT7J6-Wb_iHA",
  "text": "크 지린다 지려 물색보소~~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxgXVaSLtrtAtMmGK14AaABAg",
  "author": "UCVDV0_bIKbX1Aq2pGUFHtng",
  "text": "멋진 곳이네요^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzX3xbVDjUJuV0zlz14AaABAg",
  "author": "UCPA_SC5PMOTQpHL_kPVDK-g",
  "text": "김녕성세기야영장은 바람이 쎄기로 유명하죠\n팩도 좀 깊은 걸 쓰고 귀찬아도 스트링 다 박고 추가로 줄 연결해서 박는게 좋아요\n저도 강풍에 자다가 폴대가 부러진 적도 있고 바람이 너무 강해 타프로 바람을 막은 후에나 간신히 텐트를 설치한 적도 있습니다\n\n또한 무료시기엔 주차장옆 개수대와 취사장을 사용할 수 없으니 해수욕장개수대를 이용해야 합니다\n물통을 준비하셔야 간단한 채소등에 세척때문에 먼거리를 왔다 갔다 하는 일을 줄일 수 있어요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzxB36tuooHP869vwp4AaABAg",
  "author": "UCSESQ2eXqNT0TzDpc0hn_hw",
  "text": "떠나고싶다 ~~~~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy98DyaMuf_WiQG7CN4AaABAg",
  "author": "UC7tJvRydXZLgNqPCsbxIePA",
  "text": "좋은 정보 감사합니다~~^^\n혹시 차박 도킹텐트설치도  가능 한가요?,",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzeenCy6Y8HXdnaiRx4AaABAg",
  "author": "UClf2FFVI9eygORlldBCPKCw",
  "text": "안녕하세요~\n열심히 구독하는 구독자입니다~\n바다도 좋구한데~\n계곡에서 캠낚할 수있는 장소도 부탁드리고싶습니다^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwolE6MLORxCOsMe5l4AaABAg",
  "author": "UCmSOSshCMbl1rJt2_rxVbPA",
  "text": "보통 타프밑에 텐트 치는데 이중으로 내는것같은기분이 ㅎ 스크린타프는 애매한것같네요 ㅎ 타프만 받아야할지 텐트를 받아야할지",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw2yJHxUDuPtCUnH9h4AaABAg",
  "author": "UCOW1c2C7QZ2KBuhoDCcMJ9Q",
  "text": "역시 제주! 우리나라 맞죠? ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx-7TnJmYFjPAyF3tB4AaABAg",
  "author": "UCgn96TqMW9pGPULHyTMcM4Q",
  "text": "우와 대단합니다 이주동안 ~~~최고예요 👍",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugx-a1d-lJCxpaRLXAp4AaABAg",
  "author": "UCWOvNgeFruLxg5OFxuLu2tg",
  "text": "항상 좋은 정보 감사합니다~!\n노지캠핑 낚시 할 수 있는 곳 중에서\n미국식 카라반 진입 가능한 곳 들도 소개해주세요~",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgwGaJSS8qC2Y87rSbx4AaABAg",
  "author": "UCD6jcF3FjRqJYEahckMXDUA",
  "text": "돈이 없어 캠핑장 비용이 아까워서\n무료 캠핑장 사용 위해서 제주도 갑니다\nㅋㅋㅋㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx5u5U0USBiAla1zU54AaABAg",
  "author": "UCG64tOS0vCA9K4Ht8BqQ1Kw",
  "text": "오징어 불빛이 아니고요 낚시갈치배입니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyNCszHtzOcZVNQ6m94AaABAg",
  "author": "UC4DvvdBHToAJyXdIv85K0dA",
  "text": "모기는 어떤가요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw1d7aMBXiBxgcvr2F4AaABAg",
  "author": "UCQl6gY2tH8tP9nsBSa9QU3Q",
  "text": "개수대가 없다는거 같은데 맞습니까?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugz0pDBDGEFDAp2Z9-x4AaABAg",
  "author": "UCwePIv6V9W27cobxgXFhYEA",
  "text": "김녕 전기 사용 안됩니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz_4EcHIHNSKDEkBLF4AaABAg",
  "author": "UC6_xPCKuduqD4BVImi1i5Sg",
  "text": "오징어 배가 아니고 한치배 입니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgydPD5ZOjzbKk3dCPp4AaABAg",
  "author": "UCTR55ICQWpd5zif789F7KXg",
  "text": "지금도 무료 가능한가요?텐트",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwOH79L4qYOhXoZAOZ4AaABAg",
  "author": "UCM-FyHNyEdI3C2Gu-8y6s5Q",
  "text": "너무 좋은 영상이네요.\n동계 차박 캠핑 준비 중인데요.\n성수기외엔 무료라면 \n\n혹 전기 만큼은 사용료 내고\n캠핑 가능할까요?",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw4VRDFeXpZm5Q22114AaABAg",
  "author": "UCSx9LplFUxkQBhqZH1S5-dw",
  "text": "제주도..ㅅㅂ..",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzDvPnoEX7sWWMiBP14AaABAg",
  "author": "UCwT1q3EF3I2CXoTVs-8WWGQ",
  "text": "김녕은 개발 안되길 진심 바래봅니다.",
  "likes": 1,
  "is_creator": false
 }
