[
 {
  "id": "UgzWjtiFsEiymKLUXhF4AaABAg",
  "author": "UCYhJcg4BcEXd3hckQ1yQzbQ",
  "text": "전국 무료 캠핑차박 300곳 영상지도 https://youtu.be/mQMCYrm8fa8",
  "likes": 1,
  "is_creator": true
 },
 {
  "id": "UgyYH8BryUrcIZjL7s94AaABAg",
  "author": "UCY6H6psXEVGaDaEkg1dp2Kg",
  "text": "라라방송이 좋은이유\n영상 시작에 항상 장소 주소 알려주시고 시작한답니다.\n어떤방송은 꽁꽁 감추고 조회수 빨기바쁘죠\n라라방송 강추",
  "likes": 7,
  "is_creator": false
 },
 {
  "id": "UgyMBAoSrKSTaJQ7Pb14AaABAg",
  "author": "UCChkUc8xv26Sj7mphyNTajg",
  "text": "늘 사람이 많은 곳이죠~\n라라님 덕분에 더 많이 알려지겠네요~ㅠㅠ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugxj4NMkP0OUno1RiF54AaABAg",
  "author": "UC-FacreNUkOHyTn4EzCGgSw",
  "text": "최고예요 \n늘응원합니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxT9pd7LvrJ8ZrsQjZ4AaABAg",
  "author": "UC21xyDBlkiZwpjFOeAumNUw",
  "text": "와우 멋집니다 ~\n힐링 되겠습니다 ~\n덕분입니다 🙏 감사합니다 🙏",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxgeIViS3IuVaI62MR4AaABAg",
  "author": "UClSomyUiok8GmTCBaduAmvA",
  "text": "송림속에서 햇볕도 피하고 멋진 해변 이네요. ❤😅",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzL8_H7BaIEJy_lLFJ4AaABAg",
  "author": "UCe_UXqLAG_POQ79biasofAg",
  "text": "목소리좋아요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx17RJdt9PrOOK6d6p4AaABAg",
  "author": "UCbMfflqRXSG1hGdD322QOcA",
  "text": "너무자세히안내해주셔서감사합니다.건강하세요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwxxhShEeU1GJgwjVx4AaABAg",
  "author": "UCCb3hXt0IkfqAPr0xGS2mIQ",
  "text": "감사드립니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxOGn6D8t0eZFhPNZd4AaABAg",
  "author": "UCtamEsEQApS2vzbRbBLftWQ",
  "text": "헐 조용히 갔다왔는데 찍혔네요 검은색 루프탑 ㅎㅎ  영상 예사롭지  않게 찍고 계신분들  계셨는데  그분이 라라님이셨나  보내요😊  라라님 영상 잘보고 있습니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwRvAuntXy7GntKBtd4AaABAg",
  "author": "UC-kgPypvDsQ2oBPUAMmg68A",
  "text": "안면도 풀청하고 갑니다 다시봐도 좋네요~♡",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyChqBfMnazQ1EN3ah4AaABAg",
  "author": "UCwyayvyCVG6nA3pKRi7ezFg",
  "text": "항상고맙습니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugym65QhaQqUTtbLBq54AaABAg",
  "author": "UCPBw81z1Ta1mMDOcEI5tMLg",
  "text": "이름처럼 예쁜  곳이네요❤",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxDR42kd2-JkIvAWyV4AaABAg",
  "author": "UCmQdFcehG-rtp3YnDPRHRSQ",
  "text": "👍",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxRS_vK2CM5BW-iSdt4AaABAg",
  "author": "UCr5vZZ6QTmJRCTCUJsDpqpA",
  "text": "좋은정보감사합니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx8wU2cK_hJPzIDD-N4AaABAg",
  "author": "UCD9e5-idO6Htf1rMY5AgVYA",
  "text": "감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugxhr9gZvsMUaq1dBs14AaABAg",
  "author": "UCbMfflqRXSG1hGdD322QOcA",
  "text": "고맙습니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwdHk2_FxDLoMlQ8aB4AaABAg",
  "author": "UChrIrymNq1WScN-VLxwjoUA",
  "text": "여기 진짜 좋네요 ㅎㅎ 조용하니 일찍가서 좋은자리에서 1박하고픈 ㅎㅎ  신비한! ㅎㅎ 맛조개 있을거 같은데요? ㅎㅎㅎ  뚱땡이 자리에 저도 꼭 가보겠습니다 ㅎㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxVeNDuMAMEQQ1pYoh4AaABAg",
  "author": "UCOUPZ9rWpgQV9oTrlFyD5KQ",
  "text": "7분40초 정도에 우리집이 잠시스쳐 보이네요.태안.고남.장곡리...",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwZjiOTQmK6My1cWL14AaABAg",
  "author": "UCFBXLpfezz2stz2sUlWutjA",
  "text": "지도출간이 언제인가요 빨리사고싶다요",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugz_fun1-bTCGs2S5IR4AaABAg",
  "author": "UC5Pi-V69ximRbnIn9z-wJHg",
  "text": "여름에 가봤는데 자리 하나도 없었음 ㅠㅠ 길도좁고 고생했었어요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzkZIN6yv4k3d1aPkp4AaABAg",
  "author": "UCb4iOpSsMZu0o8ouoOaWQug",
  "text": "안녕하세요 정보 감사합니다.\n예약은 어디서 해야하나요? ^^\n차박,캠핑 기본적인 용품 어떤것들이 필요할까요??",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxfxLpcUUd5ulXRXrx4AaABAg",
  "author": "UCR5RvekwGMsLeRZuhf-_jHw",
  "text": "화장실이 멀고 전기 안되는점 진입해서 들어가는길이 비좁고 매점이 작아 물건이 없고 해루질과 낚시는 나오는게 별로 없어여     처음가시는분은 참고 하세요  7. 8 월은  2만원입니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxRET9SR4nWpkYCX6x4AaABAg",
  "author": "UCm3ANN0GYGdOuAVjm9hT_nA",
  "text": "미등록 야영장... 돈주고 불법적으로 돈을 주라고 홍보 하는 건 문제가 있네요.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwGu0rjXhl_okBrpA54AaABAg",
  "author": "UCItA0otDPZrcYQLTRWyakYA",
  "text": "정확하게 하세요  1일 숙박에 삼만원입니다 종류별로 다르긴 하지만",
  "likes": 0,
  "is_creator": false
 }
]