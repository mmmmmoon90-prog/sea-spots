[
 {
  "id": "UgyA9r-ZJEWfly2xKcx4AaABAg",
  "author": "UCVfwVNWnZFmDIucdsTiWx-g",
  "text": "혹시 인디언즈 파워뱅크로 카라반 충전 해보셨을까요?  카라반 전기가 좀 딸려서 파워뱅크로 겸사겸사 같이 써볼까 해서 알아보는데 \n블루에티랑 되는것 같은데 인디언즈는 가능한가해서요 ㅎ",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "Ugxc4tOyncB6kTrilkl4AaABAg",
  "author": "UCA7oF3uep-DOVYJ-IagDS2Q",
  "text": "바다놀 차박지 찾고 있는데 장소가 어딘지 공유부탁드려도 될까여?",
  "likes": 10,
  "is_creator": false
 },
 {
  "id": "UgzvLa_-r8ZNTeOPill4AaABAg",
  "author": "UCfplhn4IBpn6HOwoBqmBQxQ",
  "text": "영상 잘보고 좋은 곳 잘 알아가요\n비양심들 없이 잘 유지되면 좋겠네요",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "UgzqyrD85n-f1vBbn7R4AaABAg",
  "author": "UCTUZWJ-enPzwbojZ2k2G2rg",
  "text": "너무 좋은 영상 감사합니다. 보기만해도 힐링되네요... 추워지기전에 한번 들러봐야겠습니다. 동영상 1분 50초부터 흘러나오는 잔잔한 음악은 뭔가요? 디게 듣기 좋은 거 같아서요 ㅎㅎ 캠핑가서 멍때릴때 들으면 넘 좋을 거 같아요 ㅎㅎ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxeyZtChgI2e1CsW-54AaABAg",
  "author": "UCpDnXApifJF9E7JyAR9MZvw",
  "text": "우와! 굉장한 장소네요.\n항상 좋은 정보 고마워요.",
  "likes": 6,
  "is_creator": false
 },
 {
  "id": "UgzE62YqaJ6O9nK9PSx4AaABAg",
  "author": "UCc0EwZEVRGCUxC2CGWSXi2Q",
  "text": "구독했어요~~\n정보 부탁드려요\n앞으로도 기대많이됩니당!!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx4Dh-Qjj7j3L7cMOF4AaABAg",
  "author": "UCyDsTHbAMt_ZxxtzbzMifgg",
  "text": "노지가 전기만 있다면 최고죠!! 좋은 정보 땡큐요~~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxGiu6lzMqEGfBQ44l4AaABAg",
  "author": "UCTY_d5T4eTLXZyM7p7sfDqA",
  "text": "구독했어요^^  좋은 장소 자세히 알려주셔서 감사합니다  크린캠핑 합시다♡",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxJ3swe6FtX3eWAlDN4AaABAg",
  "author": "UCx2BqZsjTxm1HRDhYrn6hkw",
  "text": "와 여기도 최고의 노지 차박지네요~😆\n궁금한게 있는데요 낚시하러 나가시는 보트?는 대여해서 낚시 하는건가요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzYmJoQ3FZMYRh6I294AaABAg",
  "author": "UCi55pfL1wBCUkYu9i3_nQfA",
  "text": "노지캠핑 죽여줍니다 감사합니다 조만간 가보곘습니다~",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwFdS9YH4zWyMNHLDJ4AaABAg",
  "author": "UCpdavXHRnst7ItHoGEzeGFg",
  "text": "정말 멋진 곳이네요💯💯👍👍",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz_eMmZsAvYCSEf4Wt4AaABAg",
  "author": "UCZqz1NlL0ezr2UH7tpl_Njg",
  "text": "안녕하세요 서해안 차박지 찾아보다가 오게.됬어요 구독 눌렀어요 차박지 공유 부탁드립니다 ☺️👏🏻🍀",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugwj8o7cOGhFuRMzmnR4AaABAg",
  "author": "UCChkUc8xv26Sj7mphyNTajg",
  "text": "잘 보고 갑니다~\n예전에 답사 갔을때는 카라반 놓은 자리부분이 없었는데~만들었나보내요~\n정보감사합니다",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugyg3ujgi2QHixq8lCt4AaABAg",
  "author": "UCMOc0E2k9NCZDHeVbS4CMbQ",
  "text": "맘만  매번 먹고 실천을 못하는 캠린입니다~구독합니다~장소공유부탁드려요~부럽네요~~",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgzwkA3YajQxomxyALh4AaABAg",
  "author": "UCur92b4AVG_YTYfn4EosuJw",
  "text": "엌ㅋㅋ 어딘가 했더니 저희 할머니댁 바로 앞이네요 ㅋㅋㅋ  반가울데가 ㅋㅋㅋㅋ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugzj7bqYy1xHfHpBn0J4AaABAg",
  "author": "UCTrtjLVXz4o_IC15VPbhreg",
  "text": "좋은 정보 감사합니다 ~",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugy3dhyHUB-D6x4e0AV4AaABAg",
  "author": "UCSDvsh852f4J9-zR0Jm5wXA",
  "text": "덕분에 힐링합니다 잘보고갑니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwFQe9Oyl5R57JzUiV4AaABAg",
  "author": "UC2ecXthuVcMFhl8yia0BF1g",
  "text": "안녕하세요 ~^^규나사랑대구입니다 ^^\n언제나 영상잘보고 있습니다~^^\n필드에서 한번뵙고 싶네요~^^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugyq9daV0jrdbL4Gktl4AaABAg",
  "author": "UCymwVDHV2wjISaUp2hRa9RA",
  "text": "너무 좋은 장소, 정보 공유해주셔서 정말 감사해요😊",
  "likes": 8,
  "is_creator": false
 },
 {
  "id": "UgznUSdPprDCv-vhhox4AaABAg",
  "author": "UCI-RXDSErPTJCivci04R_Tw",
  "text": "영상잘보고갑니다😊",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz8C4HFw1vU4NOs7dN4AaABAg",
  "author": "UCTLzdGmnb6iaa4IzW69EPtg",
  "text": "여긴 어디일까요?\n넘  좋아보이네용~~",
  "likes": 6,
  "is_creator": false
 },
 {
  "id": "UgzEy4E4NebTav10v9B4AaABAg",
  "author": "UCN7JW0TdqxvurUHuU-dDe8A",
  "text": "구독!좋아요눌르고갑니다\n좋은정보 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwuuwxN1FKsKqT5N4Z4AaABAg",
  "author": "UCaqP_w0uyNvJco4eFDP5tng",
  "text": "구독완료!! 염치없지만 장소 공유 부탁드려요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyVRlaJGXED5ScqXYR4AaABAg",
  "author": "UCqA-o9rtQknPgxTg4u77mUw",
  "text": "좋은곳 리뷰 감사합니다.위치좀 공유해 주심 감사하겠습니다😊",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzhoFj3Q9TOpFbRRpR4AaABAg",
  "author": "UCRWsPqnnaAfGg0fGD9UX6yw",
  "text": "노울캠핑 안녕하세요 정보가 가득하네요 ~\n감사합니다 \n구독,좋아요\n꾹 눌러습니다^^\n정보 부탁드립니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxQbUpBkvSbJf20dd14AaABAg",
  "author": "UCRM0hYaCjPV5ajQ2xF3aySQ",
  "text": "구독완료입니다~^^ 장소부탁드려도 될까요~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgztOAxCTDSzblXXlLd4AaABAg",
  "author": "UC9211PGYoPMmSXjs0ZR7l4g",
  "text": "영상 잘봤습니다!!! 위치 공유 부탁드릴 수 있을까요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxjrOONBNaFl31Z-iB4AaABAg",
  "author": "UCo4gRia_fghEFj4lyN98OVw",
  "text": "좋은정보는 나누는 맛이있죠\n장소 공유해주셔서 감사합니다.\n오늘도 영상 잘 보았습니다\n❤❤❤❤❤",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "Ugw3kg9sFr3fQqZFA9N4AaABAg",
  "author": "UCmUG6hv4MA9uj3zL9suyRfQ",
  "text": "여기 들어가는길이 좁지 않나요??\n여행으러 한번갔다 왔었는데 카라반으로 가기엔 너무 좁아보이던데요.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxAI2kJNfm99I-2E2x4AaABAg",
  "author": "UCekevJ8FWcyCqSCOyN0yHSw",
  "text": "구독자에요~^^위치공유 부탁드려요~!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzS9P7Glp0Z2K8amaJ4AaABAg",
  "author": "UCOgF_1bq8LIyxU-JN_mAz9Q",
  "text": "여기 배타고 들어갑니까~?\n공룡섬같은데..",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgxIDgcOPTZHjMQ_JZp4AaABAg",
  "author": "UCzVAR-OihZ_EXlMPicv7xMQ",
  "text": "2번이나 봤는데 장소공개가 없네요 ㅠ 장소 공유 부탁합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwpXj0k9DmBxyvwkXR4AaABAg",
  "author": "UCGikJcTTlm800QGHMKAVA-A",
  "text": "대박",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw14FKa1ny4Rmik_wN4AaABAg",
  "author": "UCiWBbUB1e_s_ExaJhHaTRMg",
  "text": "경남쪽을 검색했는데\n보령까지 나오누....ㅋㅋ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzNwwUAX7b_QhJt2bd4AaABAg",
  "author": "UCWBrv6IxPSUJ7lrgsOYNQaA",
  "text": "영상 잘 봤습니다 장소가 어딘가요 캠핑 초보라 어딜가야할지 막막해서 검색하다 시청했습니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwSW6YBI46WGAtESPR4AaABAg",
  "author": "UCFybpcCw72zUUMULOHyEnOw",
  "text": "저도 장소 공유받고 싶은데 가능할까요!!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugzz71nCKYQ9_l8ZN0t4AaABAg",
  "author": "UCUiSg5i4OfPoAnazF1f4Bzw",
  "text": "❤구독했습니다. 위치공유 부탁드립니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxOqXMRYgmvmodQ7bJ4AaABAg",
  "author": "UCwq3EnxjYNJCUWYKERpKN-Q",
  "text": "태양광,파워뱅크 구입처 알수 있을까요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw7du7FzZdSP5O3_X14AaABAg",
  "author": "UCY45eZRlqFuz5Oe8agooB4g",
  "text": "제가 아무리 찾으려해도 장소를 모르겠네요 \n여기가 어디죠?",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwHB280fxa9rk7ia2V4AaABAg",
  "author": "UCA549wNG_YT0_P-SYIqX66Q",
  "text": "안녕하세요!!! 혹시 장소 좀 공유받을 수 있을까요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwIB1FppCLCNmU_Klt4AaABAg",
  "author": "UC8SqxdmPejHsYvU3S4WIoig",
  "text": "3개월전인 여름이였던가..😢😢",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzgSowvdZF3HGeIh8d4AaABAg",
  "author": "UCMLz97QOhvWkg_KrtFqjo7w",
  "text": "종이컵세대시구나~ 난 신문지 세대...ㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgybKLxJ1MNvoraj2LF4AaABAg",
  "author": "UCseLulDECb9cN21cLP-hBZw",
  "text": "저 혹시 제가 캠핑을 처음 가볼려고 하는데 저런곳에서는 불멍 같은거는 불가능 하나요?? 다른 노지 캠핑에서도 아예불가능한지 알고 싶습니다ㅠㅠ",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "Ugw6N9bCC6Ejd7ipMJt4AaABAg",
  "author": "UC1s4Xj2G87_38dBkDe01bHg",
  "text": "그런데 정확한 장소는 어떻게 되나요?",
  "likes": 38,
  "is_creator": false
 },
 {
  "id": "UgzRz1US_h-Yx8VQkVV4AaABAg",
  "author": "UCLi7GWBfwkiLW3Kb_8KkyMg",
  "text": "위치공유부탁해요😅😅",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwSdUNmuZ6rFs6bAu14AaABAg",
  "author": "UCcWmBNx8m73r1D_X3GTDxVw",
  "text": "캠핑초보입니다 ~조용하고 너무 좋네요 ~장소공유부탁 드려요 감사합니다 ~~",
  "likes": 6,
  "is_creator": false
 },
 {
  "id": "Ugz9jgCssW17ZtvNFq94AaABAg",
  "author": "UCUQDPCu2zx0EjvOjTUhEjyQ",
  "text": "공룡을 보니 모도같아요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyifvEA-ZscozjXa0h4AaABAg",
  "author": "UCakxbPheC976VCnA8LTIk5w",
  "text": "오덴교~~여는",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxqWjcRejxxwwFCjAV4AaABAg",
  "author": "UCPYoQ7CWm7YeKgkrNkgyXew",
  "text": "그래서 어디란거에요?",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "UgzAoFsxe7CS7ElifnR4AaABAg",
  "author": "UCw1vGovD87J6ETDAGHWNAfg",
  "text": "돼지.소키우는  농가들이 많아서  냄내가  장난아님~ㅠㅠ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzKsFcSD0UilMC6KuF4AaABAg",
  "author": "UCuQAwba-2XZESNyUaqf2OAg",
  "text": "와우 멋진곤 소개가사합니다😊❤❤응원할께요 ❤",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxreE9oe2ngcrmphsF4AaABAg",
  "author": "UC3hJ1kJKQvhb-Mur3eXl7GA",
  "text": "거기도 쓰레기 넘처 페쇄 되는거 아닌지요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzDepnQx5D4LbIxAJR4AaABAg",
  "author": "UC5nat941iBsF2Gk8Zk6dXWw",
  "text": "저 혹시 이번주에 가려고 하는데 아직 차박 가능할까요??",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugzg-L7HJC-8C4dFVHV4AaABAg",
  "author": "UCWGp1MOrYC7TtCvbKloXQKQ",
