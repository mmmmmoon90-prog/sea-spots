  "id": "UgwUngtgF7wjGY2JbVJ4AaABAg",
  "author": "UCfQvJbo0Y2L5lbjsdAx8gtQ",
  "text": "파이팅하시고 클린캠핑~~가즈아~",
  "likes": 1,
  "is_creator": false
 },
