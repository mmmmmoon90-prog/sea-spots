[
 {
  "id": "UgxelWn_KhOs9E_rUGJ4AaABAg",
  "author": "UCem_mPpiURPjmw4FcYpxz3Q",
  "text": "금지푯말에 어쩌라고요;;;;; 멘트참ㅋㅋㅋㅋㅋ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugx4_JGdu6fcBABy9F54AaABAg",
  "author": "UCOGV2o0UHVaXDj2D1gpgv2g",
  "text": "도킹차박 새로운 캠핑 트랜드 신조어가 생겼군요.\n멋진 연휴되세요.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz443MlpIbTfIbkriN4AaABAg",
  "author": "UCOxTAXNR9cIXlVFgeMOxmWg",
  "text": "저희도 일단 캠핑카로 시작은 어렵지만 차박용 텐트설치해서 아가들과 좋은 추억 만들어 봐야겠어요ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwAJQjmMniZCPVLFYV4AaABAg",
  "author": "UClSomyUiok8GmTCBaduAmvA",
  "text": "좋은곳 멋지게 알려 주셔서 감사합니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwtlCEem7QOGE2Mr0J4AaABAg",
  "author": "UCmvkBYYwsmK0-YMU2Vs8JPw",
  "text": "라라님멘트 넘~~듣기좋아요~~\n좋은정보  늘 감사합니다~~",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxpL1nghaEO5Rgw2SB4AaABAg",
  "author": "UCL7hoFIkuw3ACuWcIVU92Rw",
  "text": "설악해변은 몇번가봤는데\n후진항은 기억이없네요\n담에 들러봐야겠네요\n오늘도 좋은곳 소개영상\n즐감했어요^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwQficmKd0Aatk-1n94AaABAg",
  "author": "UCaSVsBCDe11C1IQ09oA72ng",
  "text": "라라님 영상잘보구있어요 감사해요 영상보면서 대리만족하고 있어요 사람들이왜 라라님영상을 안보시는지 답답하네요 ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugww5IXVWOMcJHahMvV4AaABAg",
  "author": "UCkuLHcjViNLN57gAdDHed5A",
  "text": "오늘도 힐링영상 잘 보고 운동하러 갑니다...^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyY7w4W8ieQc3x6WFN4AaABAg",
  "author": "UCelgCCqj1JgokDIImV1Q6CA",
  "text": "톱질 또 나왔네요 ㅋ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxMo53iQvY0nwDPhh94AaABAg",
  "author": "UChrIrymNq1WScN-VLxwjoUA",
  "text": "화이트 ㅎㅎ 귀여우셔요 ㅎㅎㅎㅎ\n둘째주 토욜에가야겠군요 ㅎㅎ 마켓열리는거 구경도하구요 ㅎㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
