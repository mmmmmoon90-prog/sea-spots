[
 {
  "id": "UgzJQfzF-GqpBLRNtRd4AaABAg",
  "author": "UCH_xcnZwcgUvq5M-Nm4rivw",
  "text": "거제 가조도 신교방파제!!!\n11월부터 3월까지 꾸준하게 조황이 좋은 곳입니다\n고기보다 사람이 많죠 ^^",
  "likes": 13,
  "is_creator": false
 },
 {
  "id": "UgxV3LMcnMpJ9p4o8RR4AaABAg",
  "author": "UCyGOK3GdVrn9VKsm5jWWZtg",
  "text": "햐~~\n내가 낚시를 안다닌지 오래됐구만...\n가조도 안간지도 엄청 오래됐고...\n신교항 저기 도로입구 넓은공터 \n없었는데... 생겼네...",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "UgzLewZQpznidGYAhQJ4AaABAg",
  "author": "UCRQ82Xe84uGJzJ5yXn7j7bQ",
  "text": "입구에 깨끗한화장실 있어요\n고기가없음",
  "likes": 8,
  "is_creator": false
 },
 {
  "id": "Ugw_PTqte8DWh12zLyx4AaABAg",
  "author": "UCKBsxbWWi7kgBCUmUY10UaQ",
  "text": "가조도는 쥐새까가 너무 많아서 다시는 가고 싶지 않은 곳 ㄷㄷㄷ",
  "likes": 9,
  "is_creator": false
 },
 {
  "id": "Ugy9D810dHdEb5I3Usx4AaABAg",
  "author": "UCNzM8SCXRrh6yllB7FI4XtQ",
  "text": "이 영상보고 겨울시즌되면 매년 3-4회 정도 갔었는데...고기 얼굴은 못본곳....25년도를 끝으로 감성돔 잡으러는 안가기로 마음먹음.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzNOTFRp57RnZO_fRh4AaABAg",
  "author": "UC-xMY4_uITvWAZQpAQuIMIA",
  "text": "가조도 신교방파제는 6월부터 10월까지 감성돔 나오는데 4짜는 6,7월에 나오구요.\n숭어는 7,8월.\n고등어는 7월말부터 8월중순까지 30정도되는 고등어 나옵니다.\n고등어는 매년 같은시기에 꼭 나옵니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxS1cihubJ8fuMX0L54AaABAg",
  "author": "UCxkjfA3kzYe5bpKS_iHkQSw",
  "text": "가조도에는 생명체가 없던데....",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "Ugyc67JTG5k9jaXeye54AaABAg",
  "author": "UC_CSCiRGIyRsTBaDsmZNaKA",
  "text": "신교방파제인가요~?",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "UgwFN3mpPFklkcNADkx4AaABAg",
  "author": "UCY5TOFnPWaH5ntOeII47BRQ",
  "text": "저기 고등어들어오느곳 그냥저냥\n고기가 많지는않음\n무늬포인트로 알고있는데 입구 갯바위쪽",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugwn6W5d16GiiZBks_x4AaABAg",
  "author": "UCgSB--wqISH2yImuVbKLbtA",
  "text": "주말엔  사오백명의 낚시꾼과\n그 가족들이 와서 놀다가 가는데\n쓰레기는 사방에 날리고 , 밤새\n고성방가에  냄새도 만만찮죠\n시골이라 대문앞과 도로가 분리되지\n않는곳이 많은데 자리선점에 눈돌아간\n낚시꾼은 쏜살같이 날라가죠 .\n시골인심 ?  한달만 살아보면 가끔씩\n살의가 들게 될겁니다. 가조도 제발\n가지 마세요.",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "Ugzqe6y1MTS7btnlaCF4AaABAg",
  "author": "UC5xoMTdsOtukXxWWxEWv_aA",
  "text": "여기 어떻게 갑니까?\n디렉션 부탁해요 지리을 잘몰라서요 😂 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy6jh3GPIwZiAZescV4AaABAg",
  "author": "UC5xoMTdsOtukXxWWxEWv_aA",
  "text": "너무좋은데요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugwq1rlW-C0y5mBSVx54AaABAg",
  "author": "UC3mto6PAgI3bRY4OvJT4IXw",
  "text": "저기 고기 잘안나옴...ㅋㅋㅋ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugy5pk1gjRZ-f48iTHp4AaABAg",
  "author": "UCp7kzR3FOwaMs7EFuzxyDzQ",
  "text": "고기없슴 덕곡 낱마리",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyvejkLj734xgalxAd4AaABAg",
  "author": "UCjpcRTyOnZXlBu4EXj7HaPg",
  "text": "사람만 가득잇겟네",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwRnLciMyGpl7WqbIB4AaABAg",
  "author": "UCvxtEmIxPKz5GPTMFKRkjRg",
  "text": "무늬 포인트죠",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugx65-Ln42trLKGtNHN4AaABAg",
  "author": "UC5xoMTdsOtukXxWWxEWv_aA",
  "text": "미국사는 교민입니다 \n새해에 방문예정입니다\n1월에도 낚시될까요? \n가고싶네요  수고하세요 영상 감사드립니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxO901YXjPEuK9FsMR4AaABAg",
  "author": "UCKX1N6QvI41YXuhuW60zcmQ",
  "text": "잘되진 않아요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgynP4YFJ01kMGXMP394AaABAg",
  "author": "UCS_rqcgVRL1Bn5NW9DzxILA",
  "text": "오염수 유명한대 낚시가 그렇게 중허냐!?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyQJCggA2j8dt6RP9V4AaABAg",
  "author": "UCgJnLv_ONhqCSPKaAi8fTfw",
  "text": "개기없다\n거기는",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwyILxQUeIzBOk-il14AaABAg",
  "author": "UCHmZPzqBLJgZ8Bsuy86dT5Q",
  "text": "직접 낚시해보고 영상올리는거 맞나요??",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzpciU7kM0Jtig2v0d4AaABAg",
  "author": "UCSdJQ2oO1uTu5rspcwZB_yw",
  "text": "고기 없음",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzqdB4Iwq5DZBbJZEx4AaABAg",
  "author": "UCigEmQZcjCcJENI9BmROxaA",
  "text": "위치가 어딘가요 ?",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgwnoRJHNbS1GuKnsBR4AaABAg",
  "author": "UC0Tgi0a_KF40oUMbpTCb2DQ",
  "text": "화장실. 유무는?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugwmf6lb98yLU7zg69p4AaABAg",
  "author": "UCUCArk5xvwPqVdHqTEJgPNQ",
