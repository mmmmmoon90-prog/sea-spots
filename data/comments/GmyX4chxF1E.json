[
 {
  "id": "UgwvPcQ4-KtxG1z7BK14AaABAg",
  "author": "UCSZ8eujwhGMvY-dkS55v2bw",
  "text": "여기는 모르겠지만 다른 크릴은 상단은 크지만 밑으로 내려갈수록 작아짐 ㅋㅋ",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "UgynlGtLHDzwAOO7b3V4AaABAg",
  "author": "UCclysbZhBD5rSO-jk2gdgoQ",
  "text": "백크릴 해동후 글리세린에 담가놨다가 선별후 냉동실에 보관해놨다가 필요한 만큼 들어서 사용합니다.\n글리세린에 담가놓으면 육질이 탱탱해지고 냉동실에서도 잘 얼지 않아서 겨울철 감성돔 낚시에 아주 유용하게 사용합니다.",
  "likes": 8,
  "is_creator": false
 },
 {
  "id": "UgxG0X4T7qZXAzbS5BZ4AaABAg",
  "author": "UCLzndi58RHrkbXNmlcWweag",
  "text": "저는 그냥 백크릴 씁니다.\n선별 크릴이 크기도 크고 모양도 예쁘지만\n개인적으로 크릴은 한번 해동하면 입질 빈도가 떨어지는 것 같아요\n크릴은 냉동에서 막 해동한건 새벽에 갯바위에서 보면 살짝 살짝 야광도 띕니다",
  "likes": 8,
  "is_creator": false
 },
 {
  "id": "UgxeAUcQ16Sv5hld1Yt4AaABAg",
  "author": "UCMifcuhHq2TwLEbJ14y9YqQ",
  "text": "앞으로 더욱 소중히 한마리 한마리 소진 하겠습니다..^^*",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxhTc14kShtVw6Egzt4AaABAg",
  "author": "UCZVoHbo7msl-nw7G_Fet-bw",
  "text": "일일이 수작업이라니 생각도 못했네요",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgzcjBSKByIGuLUIKC54AaABAg",
  "author": "UCUflWqOpZnPQwSG_gazZZnw",
  "text": "아빠랑 낚시가면 쓰던건데!! 신기해요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzB2PVYXdaPC73kkT94AaABAg",
  "author": "UCKZfpNGcxYoEttg9NxgdYIQ",
  "text": "오랜만에 영상올리셨네요 ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzlkK1Y0Lx5SMK8I5Z4AaABAg",
  "author": "UCSWO8zPDK88F5Bgtfmju0xw",
  "text": "사장님 인자하시고 한국 낚시계를 사랑하시는 분이네요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy4Y2COCgZOd9rs24N4AaABAg",
  "author": "UCDhA2gjjxypylTMhtjCrOpg",
  "text": "좋은 영상 감사합니다 ㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyLGaTlLF4hOFZ-hR94AaABAg",
  "author": "UCKpO7y35M6EHQp2DYqGrwqA",
  "text": "손이 많이가는 작업이군요 대표님께서 집적 국내생산을 해보시는게 ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzwaUW_jMUCM5YE3YB4AaABAg",
  "author": "UCr8g1Z5zWCTzM1JmDI5JE1A",
  "text": "간접 견학 시켜주셔서 감사합니다!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx4F5kruq7fOQvSCu94AaABAg",
  "author": "UC2eynC47i4qhIFu166W58QQ",
  "text": "덕분에 잘쓰고 있습니다 항상 감사합니다🙏🙏",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwvopxAQkkrv9IJZ454AaABAg",
  "author": "UC8bIriZDEeoZIX1Oe5QhD7w",
  "text": "사장님 말씀중에 성실함이 묻어나네요 정우크릴 기억하겠습니다 낚시꾼으로서...",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzaMvkRBioOSgZpYIZ4AaABAg",
  "author": "UC_HfMAK2s-UCpkK5tP8LMvw",
  "text": "잘만들어주셔서 저도감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxDPGD9ekvPDsee4Q14AaABAg",
  "author": "UCWKfUSMaFEKqhOSfVJkZtsA",
  "text": "앗~! 연휴 때 쓰려고 오늘 크릴이랑 sb성게밑밥 3키로 택배로 받았는데 ㅋㅋㅋ 이 업체가 딱 나오네\n너무 반갑네요 ㅎㅎ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxQINzfbAp4QOJ10wZ4AaABAg",
  "author": "UCTDcwq5PS9oRxGWAI7Gg6_A",
  "text": "행님 영상 자주보고싶어요\n한아이의 아부지가 되셔서 힘든거겠요?ㅠㅠㅠ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzZnAa0v0SqOLRQ4AN4AaABAg",
  "author": "UCyd-pn0JkMDvl7_pwPowIqQ",
  "text": "와 내가쓰던게 이렇게 만들어지네",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyGhgBXi-RYdIfjt1R4AaABAg",
  "author": "UChSleaqRQC2HvLxKW_awcdQ",
  "text": "잡어는 안먹고 돔만좋아하는 미끼 만들어주세요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwimSU4LLnVIthwYDZ4AaABAg",
  "author": "UC5d956NufQu4PYyyN0LTNYg",
  "text": "솔직히 레시피 기대하고왔다 손!",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugw5CP1zkgV57eS6oNx4AaABAg",
  "author": "UCoLfWPoZmsc0M0hveNUPfVQ",
  "text": "크릴공장에서 일하면 머리카락에서 새우냄새가 안빠져요 ㅠㅠㅠ 그만두고 한달동안 머리에서 새우냄새 났어요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugx6mE2_WKLkNRos-bh4AaABAg",
  "author": "UCwtuvPeewmC_mNEU0D5FGKA",
  "text": "공장 누이들 욕보시네요😢",
  "likes": 0,
  "is_creator": false
 }
]