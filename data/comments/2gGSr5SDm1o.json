[
 {
  "id": "UgyKnrVjZOLGmHt_Azd4AaABAg",
  "author": "UC3s4uJf3sD2yC-uA9Ra8vYQ",
  "text": "항상 좋은 정보 너무 감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgyeaXxDqRfAPDtBwUl4AaABAg",
  "author": "UCNgSQFyKYeNeDL_k2GQGE0g",
  "text": "선따봉 후감상! 늘 좋은포인트 소개로 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzhvLentxmPwusmJkV4AaABAg",
  "author": "UC2UsUZ-FCn_7CdWRpzNhzfA",
  "text": "낚시방은 죽변면사무소 방향으로 큰길로 내려가야지 나옵니다. 사거리 번화가 기준 100m 사정거리안에 낚시방 넘쳐납니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwnxFsFKpiyu8ZruWp4AaABAg",
  "author": "UCxWxUUb2qF8UI6EVb4RqH1g",
  "text": "오늘도 잘봤습니다. \n감사합니다.\n3천 구독 축하합니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzPJVKRNEhUIGnqVB94AaABAg",
  "author": "UCU_DxNGDWQkPIZmVVhqEi1Q",
  "text": "오와ㅎㅎ진짜 가보고싶은 포인트이네요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy8y4UtRx33Pa1BDjl4AaABAg",
  "author": "UC1suR32ANLOMmQ4D8XAgalA",
  "text": "남해 쪽도  가주세욤  통영 고성 거제  등등ㅋㅋ 궁금하네요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugyth3Vy0MCPWovCXcN4AaABAg",
  "author": "UCKrdC6Ra90BAx3M032ILnsg",
  "text": "저때문에 갔다오셨군요....감사합니다..ㅎㅎ\n아닌거 아는데 그냥요^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyOe9a8AHrWEQ98Bb14AaABAg",
  "author": "UC8kxJYkwPRrPZVXURWy3D2Q",
  "text": "고기 잘 안나옵니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxnAClBluwix-QQfdh4AaABAg",
  "author": "UClgIITjA_fmfqqUs44I4bfg",
  "text": "안녕하세용 ㅎㅎ 첫 원투에 입문한 사람임니다 처음이다 보니 포인트를 너무 몰라서용 ㅠㅠ 영덕권에서 해변 원투 칠만한곳 없을까요?? 화장실도 있는 곳이용 ㅎㅎ 있을까요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzALZ9kgjR-3cE3lYN4AaABAg",
  "author": "UCOftwf8QOjYe2hGJh9YrO9Q",
  "text": "왠 울진???  남해쪽은 안 가시나요?\n어째든 1빠 입니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzF8-JFv4gufPC1mjJ4AaABAg",
  "author": "UC8kxJYkwPRrPZVXURWy3D2Q",
  "text": "거기 고기 흐물거린다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgziC0YXFHm-y7iYukB4AaABAg",
  "author": "UC8kxJYkwPRrPZVXURWy3D2Q",
  "text": "물 흐리지말고  영상 내려라",
  "likes": 0,
  "is_creator": false
 }
]