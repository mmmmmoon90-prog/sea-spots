 {
  "id": "Ugz9KqvrMH6SmlDAEOl4AaABAg",
  "author": "UCqxhYEGlDAR-Yzekt6G4zIA",
  "text": "어디에요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy8OmZb1snR-wjndzV4AaABAg",
  "author": "UCad3LV85Tu9cMASrJFHEwZA",
  "text": "쓰레기만 제발 잘 치우고 다니는 캠핑족 됩시다 여러분",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgweWgNZWKxaZAuHxZZ4AaABAg",
  "author": "UCdqGosP1mcgmB9ES5rWZbAw",
  "text": "😊차박 못하게 막아야함",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzBB49OmKAXSQZGMxR4AaABAg",
  "author": "UCVhFQhms9hFBRai0RqMEIvg",
  "text": "여기주소좀알려주세요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwwAw0c5hb00EhMOit4AaABAg",
  "author": "UCw8xCNdmMQkXgFYVlKboTog",
  "text": "정확한 위치좀 알려 주세요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxpIrb-5aReqFIZyc94AaABAg",
  "author": "UCx1ysHtSi9anhdgVApMKkVw",
  "text": "불 사용 가능하나여?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugyimv4V1qyptblhPg94AaABAg",
  "author": "UC5zeAqcAL_681CKo6or5c8A",
  "text": "지금은 막힌듯",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwS4W1GbegQBRbxykJ4AaABAg",
  "author": "UCz3bpnF9X9xvg-OjzMSGjPA",
  "text": "무료낚시인가요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxKCLJ_9fp2mxNJj1Z4AaABAg",
  "author": "UCK7hMZQlinRrKTAvUAMz_dA",
  "text": "내일 막을예정",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxixGkvor-UGQy_Wnx4AaABAg",
  "author": "UC2Tn3bcjT3UO5VQ-2sUQYvQ",
  "text": "장소가어디요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyUc3GOqb4Az1MPP5l4AaABAg",
  "author": "UCjGy8TgNLTHS6O8blj8Mkng",
  "text": "막혀습니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyvBz66b458EE5VMXl4AaABAg",
  "author": "UCYyz3h9Yi6XwnPkt3y4UXpg",
  "text": "어디냐구요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxwYZEuv4j3DTMZ9jt4AaABAg",
  "author": "UCZbNAHzqPq-ZyA2kUyVc4ow",
  "text": "저혹시 화롯대도 사용가능한곳 인가용?",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgwaP2CPOpgKvd8UEMt4AaABAg",
  "author": "UCaPLyeyP738rwsxq3_4AkIA",
  "text": "그래서 어디인가요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgywQKNn_mIk17Ln8Kx4AaABAg",
  "author": "UC7bskG5dqSORyCQrS9v9k-A",
  "text": "공유하지 마시지ㅜㅜ\n걱정되네요",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "UgxHO9s0iA41Oz3cK3R4AaABAg",
  "author": "UCV97NrgLHphunsH8zJNsz5w",
  "text": "오늘 왓는데 막혔네요 유튭보고 처음 왓는데 낚시 마트 사장님이 그러는데 어제 막혔데요 4월 29일 ㅎㅎㅎ 사람들이 쓰레기는 둘째치고 집에서 쓰던 버릴 가구들 의자나 잡쓰레기를 놓구 간다네요 인간들이 왜들 그러는지  ㅠㅠ 헛걸음들 하지 마셔요",
  "likes": 38,
  "is_creator": false
 },
 {
  "id": "UgzShempFwrdnDqN2D54AaABAg",
  "author": "UCEojuzocWWmG94_Hd8NAk3w",
  "text": "어디라곤 이야기안하시네요. 휴.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyuIR47SVO5vQYAP4Z4AaABAg",
  "author": "UCq-XJUij1qCPQVzL0QPPEUQ",
  "text": "지금 가도 괜찮을까요??",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzZ28O0GJ7rbmxgNMR4AaABAg",
  "author": "UC1bFxGY8zFMNDF8hYrKd5qA",
  "text": "유튜버들이 문제입니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugwu3R6vSn6pCk2npat4AaABAg",
  "author": "UCMBHRm04SCfNS0snnwEdMiQ",
  "text": "여기가 어디인가요?",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyBaJinq9QnLK6LK794AaABAg",
  "author": "UC_XI2QHfGi20yQryYkYEnaQ",
  "text": "저기가  어디인가요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy5p7sG1DkvbbdQWjd4AaABAg",
  "author": "UC1Jjb2zJlj_AH0wBrW3tlSw",
  "text": "이제 쓰레기 넘쳐 나겠네...",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxGZjatLDlQnMKUZ014AaABAg",
  "author": "UCKT3Rb5uDBnjpA6h9Bs0pDw",
  "text": "장소 공유는 안하나요",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "UgwPXp9EfAJ0k7yyde94AaABAg",
  "author": "UCRK-mQbC80GW8NMmUJ1NlLw",
  "text": "위치어디인가요?",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyzHh8qUuzQgfClF5F4AaABAg",
  "author": "UCnOpx8liDSZ-QVVbDxOrbLQ",
  "text": "장소는   어떻게   되나요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzstPnEXuP5uLt_CLB4AaABAg",
