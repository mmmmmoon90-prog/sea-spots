[
 {
  "id": "UgyoUaOBk7E6y7OqG1J4AaABAg",
  "author": "UCYhJcg4BcEXd3hckQ1yQzbQ",
  "text": "🟥무료 캠핑차박지 300곳 전국 영상지도  https://youtu.be/mQMCYrm8fa8",
  "likes": 0,
  "is_creator": true
 },
 {
  "id": "UgxOhYr25AT5hCDSfiJ4AaABAg",
  "author": "UCTLMzNJnz6gtT-z3hs0MOWw",
  "text": "항상 감사합니다\n너무 자세하게 설명목적지\n해주셔서 잘보고있고\n많은도움됩니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgywNkmhED-qI8CRITB4AaABAg",
  "author": "UCqXs3PoJBXw2Hh7XYRJSKCQ",
  "text": "젊은시절 주구장창 낚시 다니면서 옆동네같은 여수네요 ..참 좋은곳 많죠  여수 시청에서 표창장 준비 할검니다  ㅎㅎ  금오도  비렁길   환상이죠     ^^",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugwnoylu6_TzZnPpjfh4AaABAg",
  "author": "UCOGV2o0UHVaXDj2D1gpgv2g",
  "text": "연일 수고가 많으십니다.\n늘 안운 하세요\n좋은 곳 풀청하고 갑니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwFJnGaVifSFQWv2a54AaABAg",
  "author": "UCvR5_GTksSKWBQepr8IWUYg",
  "text": "늘 좋은 정보 감사합니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugy-Xes6gxgg3rZ-Yzx4AaABAg",
  "author": "UCTLMzNJnz6gtT-z3hs0MOWw",
  "text": "항상. 안전운전 하시고\n좋은정보부탁드립니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxAObQpKtRW_NJEFzV4AaABAg",
  "author": "UC37K5hpO1C1UMFtxnfvcnIA",
  "text": "늘 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxQh1D87-HAVNa4_AZ4AaABAg",
  "author": "UCwyayvyCVG6nA3pKRi7ezFg",
  "text": "항상고맙습니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx0BJlUP6fQAo906SJ4AaABAg",
  "author": "UCkrE0N7L0Q4BHTSeMP7Wefw",
  "text": "영상고맙습니다ㅡ건강하세요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyCHrIqjLRe82SqCSx4AaABAg",
  "author": "UCt3DEmIrslXIn-Al-9D41Aw",
  "text": "감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw2797Xj349wkugNGt4AaABAg",
  "author": "UCpMqR7Fi7Y6yz2U9BNvR2bQ",
  "text": "주인장 여수에 오셔군요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugw1mxSNQz1N805RtHh4AaABAg",
  "author": "UC1znk8tDn8T0fLBhBDu0kNg",
  "text": "드론촬영에 편집 스크립트 나레이션 녹음까지 감사히볼게요.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugw-lCcjTr4YNmlo_rh4AaABAg",
  "author": "UCIb_yzi19L2wbyGTM0XiRFg",
  "text": "최근 차박 과태료 물어여된다는 소문이 있는데 사실인가요? 카라반끌고 이용가능한가요?",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwIscU9Beym5wAFbnx4AaABAg",
  "author": "UC1yOBRDqsoPQsoOI20tCF9A",
  "text": "무슬목해변 차박 주차하고 할곳이 아무래도 안보이네요. 다 막힌거 같습니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyDFsvyDAoHRTdpfhB4AaABAg",
  "author": "UC0mGf6NcB20s8Wu7ebGpNqg",
  "text": "감사합니다",
  "likes": 1,
  "is_creator": false
 }
]