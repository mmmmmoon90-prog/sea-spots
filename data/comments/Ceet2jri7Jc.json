[
 {
  "id": "UgzHzrnDqUQCG9VCre54AaABAg",
  "author": "UCtxZ_E4CwV1WBwW45CeT4eA",
  "text": "오늘도 멋진영상 잘 보고 갑니다.\r\n건강하시고 좋은 일만 가득하시길 바랍니다.\r\n항상 즐겁고 행복한 캠핑 하셔요 ^^ \r\n늘 응원합니다!!",
  "likes": 5,
  "is_creator": false
 },
 {
  "id": "UgxiUAhufGJ4oxeMqoN4AaABAg",
  "author": "UC_nsi3nbNYti68DODbWa97A",
  "text": "비가 왔으니  지금은 물이 엄청 깨끗하고 풍부해졌겠네요",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "UgxuNbe9FwRA_hm81QZ4AaABAg",
  "author": "UCQvNzbQKmsp93NFgaouepSw",
  "text": "저번주갔다왔는데 너무 좋아요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwKdtV0xk6pA3ZGpgF4AaABAg",
  "author": "UCCCMCUF9MGo_fR-q-8FKXsw",
  "text": "캬~~물맑고 공기좋고 너무 좋은곳이예요!!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwNh7YZSVVdsurJXNd4AaABAg",
  "author": "UCbM2-eVF3h1vKywiJYZK2kg",
  "text": "이렇게 좋은곳은 다음부터 같이갑시다~~~.\n꼭!!!!!",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz0Hz0wjqNecY_0Dk54AaABAg",
  "author": "UCYexnC8efCikuGFP43w-jEw",
  "text": "너무 좋네요 잘보고 있습니다 ㅎㅎ",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxgULJh_QHky-rmCRl4AaABAg",
  "author": "UCQSfI1NjpeStV-P4cNT5Bsg",
  "text": "도란도란 가족이 가기 좋은곳 소개해주셔서\n감사합니다 😊\n경치도 멋지고 여름에 계곡\n시원할듯요.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugy90Ozg6j1Cs_MTbVt4AaABAg",
  "author": "UCWHzpsINIPkxsRZ8y4v7ebA",
  "text": "좋네여",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxBQ6llINTyxU6Yf8Z4AaABAg",
  "author": "UC-0dIpCl36-AIcAriYGPRow",
  "text": "송계계곡.. 시원스럽고 멋진 곳입니다. 가봐야겠네요 😊😊😊😊",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugw5QLonOeyGu-mLCq54AaABAg",
  "author": "UC2QL8wX4UnaoiB478M60qbg",
  "text": "덕주 피크닉존 산책길도 예쁘고 당일 놀다가기 넘 좋네요. 시간 없을때는 잠시 쉬었다가 가야겠어요. 감사합니다 👌🫰👏🫠👍👍👍👍",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyZG0SkxwsxoEYTfi14AaABAg",
  "author": "UCH3MgToqcbOrtQQXaU9dOfQ",
  "text": "밀알님 긴가민가 했는데 다음에 보면 인사드릴께요.\n저희는 가족모임이 있어 영상만 찍고 얼른 이동했는데 아쉽네요.\n더운 여름 시원하게 보내세요.🥰😊",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxJm4_26gcnLtEDBnl4AaABAg",
  "author": "UCoDk1yTT3YgqQrf1J_9uiwQ",
  "text": "악어봉 가보고 싶네요..\n너무 이쁩니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwbShwSETkgIcx3TGB4AaABAg",
  "author": "UCLzylPV0y_uGOH2Gcb3gYPg",
  "text": "송계계곡최고지요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgxhQFbulr-J0vxb4s94AaABAg",
  "author": "UClxWEwZQoYeNU3kRUH6NlKw",
  "text": "좋은정보 감사합니다",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwRqeO0fmeO7_5eKbZ4AaABAg",
  "author": "UCBcymSKcMTMQhG_Zu8JBHlQ",
  "text": "욕시 바다보다는 계곡인데  캠핑카 여행은  바다가 좀더 수월 ㅠㅠ  계곡 가고 싶네요  너무 더워요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyFxA-j4sXNGfe89tx4AaABAg",
  "author": "UCR1DPWEB7IB97S9KYi0Q9RQ",
  "text": "성수기 주말 몇시까지 가야 자리가 있을까요??",
  "likes": 5,
  "is_creator": false
 },
 {
