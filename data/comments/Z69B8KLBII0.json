  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugx5bxKabGM7QeQ14Hh4AaABAg",
  "author": "UCUZ8g3SQ4WLiQhFPE2f_tdw",
  "text": "모토캠핑 다니는데 한번 방문 해봐야 곘네요 굿 입니다!",
  "likes": 2,
  "is_creator": false
 },
 {
