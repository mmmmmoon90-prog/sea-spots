[
 {
  "id": "UgxHN1RNAcwUsyn8QRR4AaABAg",
  "author": "UC9yI2HNN1wNDKthEFJxldCw",
  "text": "좋은 영상 잘보고 갑니다.\n수고하셨습니다.",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugx8cEB55JMn0QRXw6B4AaABAg",
  "author": "UCYixGbcTTO4vcQIHSaLr18g",
  "text": "저기가보니 낚시안되던데 캠핑카사면 차박허러가봐야겠네요ㆍ도전ㆍ수고하세요",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgyheyUFKlRMSDiES0p4AaABAg",
  "author": "UCJ1d9l1-27vZdnKK4KYXiHQ",
  "text": "가포고싶은태\n어디일카요!\n알려주세요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx4oDbRR_V5cKiifh94AaABAg",
  "author": "UCASmCA_23tbLxWquOmWjwKg",
  "text": "거제 지세포선창마을",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugyd6MDQkpzKMMd9ClZ4AaABAg",
  "author": "UCOwFv6jY6BP_ugE_AWjv_QQ",
  "text": "지세포에 환상적인 노을이 춤춘다고요?\n낚시 꽝이 없다고요?",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgzGq9UBf4U2hEvrbGh4AaABAg",
  "author": "UCRcDmgNY4CfOEVnK0K58MPw",
  "text": "지세포 주말에 가지 마세요 사람 많아서 스트레스 받어요",
  "likes": 0,
  "is_creator": false
 }
]