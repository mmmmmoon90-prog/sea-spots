[
 {
  "id": "UgzSC2yLvnHxy5zGIQp4AaABAg",
  "author": "UCEfn_rwy-PoHd8psemlNFGg",
  "text": "영상 잘보았내요  ^_^",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugyq5Wf-vKH_IskkPSN4AaABAg",
  "author": "UCPBw81z1Ta1mMDOcEI5tMLg",
  "text": "떠나고 싶네요..",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwgpYoJ_wooZsEwV1B4AaABAg",
  "author": "UCOGV2o0UHVaXDj2D1gpgv2g",
  "text": "감사합니다.\n봄이오는 듯한\n가슴뭉클해지는 영상과 음악에\n구시포 송림 무료캠핑장까지\n 풀청하고 갑니다.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwGeyJnDH_MepDT4f14AaABAg",
  "author": "UCkuLHcjViNLN57gAdDHed5A",
  "text": "영상도 좋고...목소리도 좋으시고...오늘도 행복하세요...^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzdFfRA0BUNd1ckpep4AaABAg",
  "author": "UCE2VGWCAHI-q_YRYb84FyLA",
  "text": "수채화속 풍경이 서쪽 놀과 라라님에 목소리와 어울려 아름답게  잘 감상했어요. ~~^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgzIbZL_658rrWqjQ2h4AaABAg",
  "author": "UCla-FudT2dgSDEPSfXK4yaw",
  "text": "해안도로 영상 잘봤어요 \n즐거운 하루되세요 🌸🌳",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx2xiSxAVriqn2tU6x4AaABAg",
  "author": "UCPbOlyY5bGOGYGn709u4LVg",
  "text": "덕분에 간접 여행을 합니다\n항상 감사합니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugw0vqXo_fBooyNvtuV4AaABAg",
  "author": "UC_TlUcfeJCMYR-_r48N7-gQ",
  "text": "라라님,\n목소리 참 예쁩니다 \n영상도 좋지만 풍광 해설 표현이 더 멋집니다.\n늘 좋은 표현력에 감사드려요",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwoPi_GMpOtdS9kX4Z4AaABAg",
  "author": "UChrIrymNq1WScN-VLxwjoUA",
  "text": "수채화표현을 너무 잘하신 ㅎㅎ  백수해안도로 드라이브해보고싶네요~~오늘도 잘보고갑니다~~^^",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugxrh0Ve31HBSqbW-s94AaABAg",
  "author": "UCM01Ail_O4_rlt9ypvlBK_Q",
  "text": "너무  잘보고있습니다",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugz_6auVKbBfsZ6rYu54AaABAg",
  "author": "UClSomyUiok8GmTCBaduAmvA",
  "text": "서해안 도로중 가장 좋아하는길 백수 해안도로 언제가도 좋지요.",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugx92KtIBM_kSG7o1s14AaABAg",
  "author": "UC324i4XrrMi5jsVBwX4n3Ew",
  "text": "항상 멋진영상 감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzKgVczn3Sa6LULAG14AaABAg",
  "author": "UCNzX0oZSKNX6KKgPCCs5esg",
  "text": "같이 드라이브한 느낌이에요~~^^\n좀더 푸릇~푸릇~할때 가면 더 좋을것 같아요",
  "likes": 1,
  "is_creator": false
 },
