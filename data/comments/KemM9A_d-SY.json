[
 {
  "id": "UgwfiFnZIk9xd8aLuSh4AaABAg",
  "author": "UCvQOH65JgI2KFpgznM3hoEg",
  "text": "영상 풀버전 바로가기 : https://youtu.be/7yvcd3TcLb4",
  "likes": 0,
  "is_creator": true
 },
 {
  "id": "Ugx5kOIcjo64ENsnZUt4AaABAg",
  "author": "UCynocuouFT_jEDD9gzyw-Ig",
  "text": "이런 영상, 너무 좋습니다. 감사합니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxIrFGiBOmC24gjG1N4AaABAg",
  "author": "UCCJGTLhgpsAP9z3erQlu8IA",
  "text": "지세포방파제!!\n고기는 있는데 낚시하기 까다로운\n곳이죠!!ㅎ",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzOhlvrpO39COJuStN4AaABAg",
  "author": "UCaQWHdH9sFMl8DBVI9wD6xg",
  "text": "거제도 2월에 저기 갔었는데 ㅋ 또 언제 갈 수 있을까",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugy9JJQk39HIGpyHn6h4AaABAg",
  "author": "UCWqN5IOOGwV7dZgac9YgsDg",
  "text": "테트라포트.\n혹시나 하는 일이 생기면,!\n줄 하나씩 감고 하는건. 어떨까. 합니다.",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzFYM7JRju3CZFEAHB4AaABAg",
  "author": "UCXkYlgiLx5B-tieJydEWk8g",
  "text": "와 진짜 좋아짐 옛날 에는  산타야했는데",
  "likes": 3,
  "is_creator": false
 },
 {
  "id": "Ugz4thZbe0kBjd5UK8R4AaABAg",
  "author": "UCynHy9PZcB02pxedmoXfGgw",
  "text": "테트라 젖어있는곳에도 사람들 많이 서있네요..... 겁없는사람들.... 대단...",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgwBcAGgjF9n2PVCG3R4AaABAg",
  "author": "UCytFTItYg9-tYlDglHlt6Lg",
  "text": "영상 좋습니다",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzCZmwPxE3GqBBB-1R4AaABAg",
  "author": "UC6LaKIMT4r76nJDj7cR1CXg",
  "text": "테트라포트(일명 삼발이)는 굉장히 위험합니다. 꼭 테트라에서 하시려면 최대한 안전하게 하시길...",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgyTd-Iqb9m3YaVU6ct4AaABAg",
  "author": "UC1oUTr9x1h4j9AO6MG4kyGQ",
  "text": "와 테트라포드 검은부분 진짜 위험하던데",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzgDykVzH8rpru_WVB4AaABAg",
  "author": "UCQVnQckHRAfVYoo79E1xE-w",
  "text": "첫번째 나온 포인트에서 보리멸잡음",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgwbxBDgZAhiYnSKB6d4AaABAg",
  "author": "UCWf8cjHX2RgwX2YTZIo6SyQ",
  "text": "좋다~~~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxoLSTlIdwHQ6AarYp4AaABAg",
  "author": "UCirZ_lhPYmQ8GtXkTn0yzCw",
  "text": "몇 번 가 뵜는데\n고기는 안 나와요.",
  "likes": 4,
  "is_creator": false
 },
 {
  "id": "Ugx9uqUCpuRxU2NQA754AaABAg",
  "author": "UCGcSijDav8uaHN8jeLSqwcA",
  "text": "낚시하긴 좋지만.고기가 안 잡혀요...",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "Ugzy6m64AM3z92LevHB4AaABAg",
  "author": "UCOK9lK3-oHH5oorOdBcw7Yg",
  "text": "두번가서 한마리잡음",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "UgxARzjFqpuqE2A--BJ4AaABAg",
  "author": "UCc38dJRci8p_nmszLkUxiIw",
  "text": "쉬면서낚시가능하게개발됨\n예전에는별거없고불편해서\n그지역사람들만가던곶임~\n지금은낚시공원입니다~\n클릴을작은곤쟁이로끼고~\n뛰울낚시.물표면공략하면~\n숭어정도는.가능해보입니다~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxHCjcNoUKRiH07OOx4AaABAg",
  "author": "UCa4uIQNWpzgpQBjsz5i3zRw",
  "text": "테트라에서낚시하면 잘못하면 낚시를그만하게될수있어요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugyp5aI8UoyzsvPP_R94AaABAg",
  "author": "UCQm7Y43iMy_3pg5JEwT1rew",
  "text": "지세포네요",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "Ugz5GdyY00uqmKz95QR4AaABAg",
  "author": "UCxwVXdX6EzEFwl5nPLfvb5w",
  "text": "그저께 다녀왔는데 캠핑카,카라반.... 하...",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgxRsMoLQycsqg-hXdh4AaABAg",
  "author": "UCSGjGrkF3KUMyjWrA2Ie2BA",
  "text": "테트라포트 위험해요 ㅡㅡ",
  "likes": 2,
  "is_creator": false
 },
 {
  "id": "UgwQnZJXrwThB_bRCB94AaABAg",
  "author": "UCoyorQDOAYHlrT4_u_eGIDQ",
  "text": "여기 밑걸림 심해서  원투하긴 힘듬 물론 입질도 없더라",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzUIjKwnQOBdHNEDkR4AaABAg",
  "author": "UCc38dJRci8p_nmszLkUxiIw",
  "text": "크릴밑밥주면서~\n고기를모아두고낚시하는곶\n그냥자연낚시는안됩니다~\n참고하시고.낚시하세요~",
  "likes": 0,
  "is_creator": false
 },
 {
  "id": "UgzmWemIPh9B2tKrMlJ4AaABAg",
  "author": "UCChd37M0LIV6-pXfMsEqG2w",
  "text": "군산은 할곳도 없는데",
  "likes": 1,
  "is_creator": false
 },
 {
  "id": "Ugyo3nSmyiSHQYKTHOt4AaABAg",
  "author": "UCHVFUjrSzWmsHceQLmDt5eg",
  "text": "어제 다녀 왔는데\n지세포 방파제는 장애인이 갈 수 있는 경사로가 필요하구요.\n낚시공원 이곳도 주차장이 구멍이 뚫린 네모난 벽돌?  같은 주차장이 되어 있어서\n휠체어가 진입하기 넘 어려워요.\n휠체어가 진입 할 수 있는 부분 만이라도 \n보도블럭 깔아 주면  좋겠어요.",
  "likes": 6,
  "is_creator": false
 }
]