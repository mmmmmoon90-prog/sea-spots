  "id": "UgzNGdvAgqCkFFYai2t4AaABAg",
  "author": "UCTqewpMkVloF9f7dvzUFV2Q",
  "text": "밤에 테트라 너무위험할것같아요ㅡ",
  "likes": 0,
  "is_creator": false
 },
